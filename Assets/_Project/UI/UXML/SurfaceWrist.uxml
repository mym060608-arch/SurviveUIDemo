<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
    Wrist terminal (Phase 06 Revision CodeReference architecture).

    Radial geometry is NOT built from dozens of VisualElements: RadialWristElement
    (injected by C# into RadialGeometryHost) paints the full triangle-mesh
    hologram - translucent local map, thin health/satiety arcs, four thick
    functional annular sectors. This UXML only hosts the geometry plus content
    overlays: map markers (absolute wrist pixels) and sector text.

    No rectangular cards, no tick rings, no white map disc, no custom cursor
    VisualElement (the wrist cursor is Cursor.SetCursor runtime texture).
    -->
    <ui:VisualElement name="WristRoot" class="wrist-root">

        <!-- RadialWristElement is created by C# and inserted here.
             This avoids Unity-version issues with custom UXML factories. -->
        <ui:VisualElement name="RadialGeometryHost" class="radial-geometry-host" />

        <!-- Full RT overlay. Markers use ABSOLUTE WRIST PIXEL coordinates. -->
        <ui:VisualElement name="MapMarkerLayer" class="map-marker-layer">
            <ui:Label name="MapPlayer" class="map-player" text="▲" />
            <ui:VisualElement name="MapLanding" class="map-landing" />
            <ui:VisualElement name="MapNode0" class="map-node" />
            <ui:VisualElement name="MapNode1" class="map-node" />
            <ui:VisualElement name="MapNode2" class="map-node" />
            <ui:VisualElement name="MapSelectedRing" class="map-selected-ring" />
        </ui:VisualElement>

        <!-- Status labels (value text sits near the thin arcs). -->
        <ui:Label name="HealthLabel" text="健康度 100" class="radial-value health-label" />
        <ui:Label name="SatietyLabel" text="饱食度 82" class="radial-value satiety-label" />

        <!-- Upper-left: Equipment -->
        <ui:VisualElement name="EquipContent" class="sector-content equip-content">
            <ui:Label text="当前装备" class="sector-heading" />
            <ui:Label name="EquipHarvester" text="采集器 MK-I" class="sector-line" />
            <ui:Label name="EquipBattery" text="备用电池组" class="sector-line" />
            <ui:Label name="EquipDrone" text="勘测无人机" class="sector-line" />
        </ui:VisualElement>

        <!-- Upper-right: State -->
        <ui:VisualElement name="StateContent" class="sector-content state-content">
            <ui:Label text="当前状态" class="sector-heading" />
            <ui:Label name="ActionState" text="勘测中" class="sector-line" />
            <ui:Label name="SignalState" text="信号在线" class="sector-line" />
            <ui:Label name="RecoveredState" text="回收节点 0 / 3" class="sector-line" />
        </ui:VisualElement>

        <!-- Lower-left: Navigation -->
        <ui:VisualElement name="NavContent" class="sector-content nav-content">
            <ui:Label text="当前导航" class="sector-heading" />
            <ui:Label name="NavTarget" text="未设置" class="sector-line sector-value" />
            <ui:Label name="NavDistance" text="" class="sector-line" />
        </ui:VisualElement>

        <!-- Lower-right: Harvest -->
        <ui:VisualElement name="HarvestContent" class="sector-content harvest-content">
            <ui:Label text="采集状态" class="sector-heading" />
            <ui:Label name="HarvestNode" text="" class="sector-line" />
            <ui:Label name="HarvestState" text="待机" class="sector-line sector-value" />
        </ui:VisualElement>

        <!-- Small identity label -->
        <ui:Label name="WristIdentity" text="NEREID-04 · 地表勘测" class="wrist-identity" />

    </ui:VisualElement>
</ui:UXML>
