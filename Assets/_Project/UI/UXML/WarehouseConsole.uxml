<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Phase 09B PASS 9 Console02 = 仓库 (Warehouse).
         Approved reference: a clean 仓库 title, two category tabs that carry
         the LB / RB paging hint, a 4 x 3 item grid on the left and the selected
         item's detail on the right. Read-only view - no item action exists, so
         the page never promises a Confirm key. -->
    <ui:VisualElement name="WarehouseScreen" class="warehouse-root">
        <!-- Title: 仓库 only (the old decorative English sub-label is gone). -->
        <ui:VisualElement class="wh-header">
            <ui:Label name="WarehouseTitleLabel" class="wh-title" text="仓库" />
            <ui:VisualElement class="wh-header-rule" />
            <ui:Label class="wh-index" text="02" />
        </ui:VisualElement>

        <!-- Category tabs; the paging hint lives in this row. -->
        <ui:VisualElement class="wh-tabs">
            <ui:Button name="WarehouseResourcesTab" class="wh-tab">
                <ui:Label class="wh-tab-label" text="资源" />
            </ui:Button>
            <ui:Button name="WarehouseEquipmentTab" class="wh-tab">
                <ui:Label class="wh-tab-label" text="装备" />
            </ui:Button>
            <ui:VisualElement class="wh-tab-spacer" />
            <ui:Label name="WarehouseTabPrevHint" class="wh-tab-key" text="LB" />
            <ui:Label class="wh-tab-arrow" text="◀" />
            <ui:Label class="wh-tab-arrow" text="▶" />
            <ui:Label name="WarehouseTabNextHint" class="wh-tab-key" text="RB" />
        </ui:VisualElement>

        <ui:VisualElement class="wh-body">
            <!-- LEFT: the item grid (cells are built in code; empty slots are
                 inert and can never take focus). -->
            <ui:VisualElement class="wh-grid-column">
                <ui:VisualElement name="WarehouseGrid" class="wh-grid" />
            </ui:VisualElement>

            <!-- RIGHT: the focused item's detail. -->
            <ui:VisualElement class="wh-detail-column">
                <ui:Label class="wh-detail-kicker" text="详情" />
                <ui:VisualElement name="WarehouseDetailIconHost" class="wh-detail-icon-host" />
                <ui:VisualElement class="wh-detail-head">
                    <ui:Label name="WarehouseDetailName" class="wh-detail-name" text="—" />
                    <ui:Label name="WarehouseDetailCount" class="wh-detail-count" text="" />
                </ui:VisualElement>
                <ui:Label name="WarehouseDetailState" class="wh-detail-state" text="" />
                <ui:Label name="WarehouseDetailText" class="wh-detail-text" text="" />
                <ui:VisualElement class="wh-detail-rule" />
                <ui:Label name="WarehouseNoteLabel" class="wh-caption"
                          text="远征装备可在气闸装备柜调整" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom key line: only the keys that really work here. The paging
             hint already lives in the tab row above. -->
        <ui:VisualElement name="WarehousePromptHost" class="wh-prompt-host" />
    </ui:VisualElement>
</ui:UXML>
