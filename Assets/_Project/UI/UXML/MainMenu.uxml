<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- ============================================================
         Phase 08 Revision 2 — TITLE SCREEN

         The whole screen is the shot: deep space and the ship on the LEFT
         (rendered by the scene camera, not by this document), and a short
         console-style menu on the RIGHT.

         Visible copy is deliberately limited to:
             活下去
             新游戏 / 继续游戏 / 选项 / 退出
         plus the controller hint line while a gamepad is in use.

         Everything else the previous cover carried (system top bar, footer,
         telemetry strip, mission/sector codes, corner brackets, scan
         annotations, the brand wordmark and 制作信息) is gone on purpose:
         this is a game title screen, not a control panel.
         ============================================================ -->
    <ui:VisualElement name="MainMenuRoot" class="main-menu-root">
        <ui:VisualElement name="MenuLayer" class="menu-layer">
            <!-- LEFT: transparent window onto the 3D hero (no chrome at all) -->
            <ui:VisualElement name="MenuHeroColumn" class="menu-hero" />

            <!-- RIGHT: title + the four options -->
            <ui:VisualElement name="MenuContentColumn" class="menu-column">
                <ui:Label name="MainMenuTitle" class="menu-title" text="活下去" />

                <ui:VisualElement name="MenuList" class="menu-list">
                    <ui:Button name="NewGameButton" class="menu-item">
                        <ui:Label name="MenuFocusMarkerNew" class="menu-item-marker" text="›" />
                        <ui:Label name="NewGameLabel" class="menu-item-label" text="新游戏" />
                    </ui:Button>
                    <ui:Button name="ContinueButton" class="menu-item">
                        <ui:Label class="menu-item-marker" text="›" />
                        <ui:Label name="ContinueLabel" class="menu-item-label" text="继续游戏" />
                    </ui:Button>
                    <ui:Button name="OptionsButton" class="menu-item">
                        <ui:Label class="menu-item-marker" text="›" />
                        <ui:Label name="OptionsLabel" class="menu-item-label" text="选项" />
                    </ui:Button>
                    <ui:Button name="ExitButton" class="menu-item">
                        <ui:Label class="menu-item-marker" text="›" />
                        <ui:Label name="ExitLabel" class="menu-item-label" text="退出" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Lightweight, device-aware hint (hidden for mouse/keyboard) -->
                <ui:Label name="InputHintLabel" class="input-hint" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 选项 (kept off MenuLayer so it never fades with the title screen) -->
        <ui:VisualElement name="OptionsModal" class="menu-modal" style="display: none;">
            <ui:VisualElement name="OptionsDim" class="menu-modal-dim" />
            <ui:VisualElement name="OptionsPanel" class="menu-modal-panel">
                <ui:Label name="OptionsTitle" class="menu-modal-title" text="选项" />
                <ui:VisualElement class="menu-modal-rule" />

                <ui:VisualElement class="menu-setting-row">
                    <ui:Label class="menu-setting-name" text="动态效果" />
                    <ui:VisualElement class="menu-segment">
                        <ui:Button name="MotionOnButton" class="menu-segment-button" text="开启" />
                        <ui:Button name="MotionOffButton" class="menu-segment-button" text="关闭" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="menu-setting-row">
                    <ui:Label class="menu-setting-name" text="界面提示" />
                    <ui:VisualElement class="menu-segment">
                        <ui:Button name="HintsShowButton" class="menu-segment-button" text="显示" />
                        <ui:Button name="HintsHideButton" class="menu-segment-button" text="隐藏" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="menu-modal-rule" />
                <ui:Button name="OptionsCloseButton" class="menu-modal-close" text="返回" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Start cinematic blackout (新游戏 / 继续游戏 -> Ship Interior) -->
        <ui:VisualElement name="MenuTransitionOverlay" class="menu-transition" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
