<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="AppRoot" class="app-root">
        <ui:VisualElement name="AppBody" class="app-body">
            <!-- ============================================================
                 Screen 01: Overview  (Phase 02 main visual)
                 Layout: top system bar / three columns / planet stage / CTA
                 ============================================================ -->
            <ui:VisualElement name="OverviewScreen" class="screen overview-screen">
                <!-- Top system bar -->
                <ui:VisualElement name="OverviewTopBar" class="overview-topbar">
                    <ui:VisualElement class="topbar-left">
                        <ui:Label class="topbar-brand" text="SURVIVE // DRIFT" />
                        <ui:VisualElement class="topbar-divider-v" />
                        <ui:Label class="topbar-role" text="EXPEDITION CONTROL" />
                    </ui:VisualElement>
                    <ui:VisualElement class="topbar-right">
                        <ui:Label class="topbar-cell" text="SHIP // ARK-07" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:Label class="topbar-cell" text="CYCLE 1842" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:VisualElement class="topbar-system">
                            <ui:VisualElement class="status-dot" />
                            <ui:Label class="topbar-cell" text="SYSTEM ONLINE" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main three-column body -->
                <ui:VisualElement class="overview-body">
                    <!-- LEFT: Ship status -->
                    <ui:VisualElement name="ShipStatusPanel" class="overview-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="SHIP STATUS" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Label class="group-label" text="SURVIVAL CRITICAL" />
                        <ui:VisualElement name="ShipSurvivalGroup" class="survival-group">
                            <ui:VisualElement class="survival-row">
                                <ui:VisualElement class="survival-marker" />
                                <ui:Label class="survival-name" text="ENERGY" />
                                <ui:VisualElement class="bar-track">
                                    <ui:VisualElement name="EnergyBarFill" class="bar-fill" />
                                </ui:VisualElement>
                                <ui:Label name="EnergyValue" class="survival-value" text="0" />
                                <ui:Label class="survival-unit" text="%" />
                            </ui:VisualElement>
                            <ui:VisualElement class="survival-row">
                                <ui:VisualElement class="survival-marker" />
                                <ui:Label class="survival-name" text="FOOD" />
                                <ui:VisualElement class="bar-track">
                                    <ui:VisualElement name="FoodBarFill" class="bar-fill" />
                                </ui:VisualElement>
                                <ui:Label name="FoodValue" class="survival-value" text="0" />
                                <ui:Label class="survival-unit" text="%" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="RESOURCE INVENTORY" />
                        <ui:VisualElement name="ShipResourceGroup" class="resource-group">
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="MINERALS" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="MineralsValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="FUEL" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="FuelValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="ALLOY" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="AlloyValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="SHIP SYSTEMS // NOMINAL" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: Destination main visual -->
                    <ui:VisualElement name="DestinationPanel" class="overview-col-center">
                        <ui:Label class="eyebrow" text="CURRENT DESTINATION" />
                        <ui:Label name="DestinationValue" class="hero-title" text="NEREID-04" />
                        <ui:VisualElement class="hero-meta">
                            <ui:Label class="hero-meta-chip" text="UNKNOWN SURFACE" />
                            <ui:VisualElement class="chip-dot" />
                            <ui:Label class="hero-meta-chip" text="RESOURCE CANDIDATE" />
                        </ui:VisualElement>

                        <ui:VisualElement name="PlanetStage" class="planet-stage">
                            <ui:VisualElement class="planet-wrap">
                                <ui:VisualElement class="orbit-ring-outer" />
                                <ui:VisualElement class="orbit-ring" />
                                <ui:VisualElement class="planet-halo" />
                                <ui:VisualElement name="PlanetDisc" class="planet-disc" />
                                <ui:VisualElement class="corner-bracket corner-tl" />
                                <ui:VisualElement class="corner-bracket corner-tr" />
                                <ui:VisualElement class="corner-bracket corner-bl" />
                                <ui:VisualElement class="corner-bracket corner-br" />
                            </ui:VisualElement>
                            <ui:VisualElement class="planet-rail rail-left">
                                <ui:Label class="annotation-label" text="ORBITAL SURVEY" />
                                <ui:VisualElement class="annotation-rule" />
                                <ui:Label class="annotation-label" text="RESOURCE SIGNAL" />
                                <ui:Label class="annotation-label annotation-dim" text="LOW" />
                            </ui:VisualElement>
                            <ui:VisualElement class="planet-rail rail-right">
                                <ui:Label class="annotation-label" text="TARGET LOCK" />
                                <ui:VisualElement class="lock-line" />
                                <ui:VisualElement class="scan-meta">
                                    <ui:Label class="annotation-label" text="SCAN" />
                                    <ui:Label class="annotation-scan-value" text="73%" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mini-track">
                                    <ui:VisualElement class="mini-fill" style="width: 73%;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Button name="OpenPreparationButton" class="cta-action">
                            <ui:VisualElement class="cta-mark" />
                            <ui:Label class="cta-label" text="PREPARE EXPEDITION  »" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- RIGHT: Current objective -->
                    <ui:VisualElement name="ObjectivePanel" class="overview-col-right">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="CURRENT OBJECTIVE" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Label class="objective-title" text="SURVIVE THE DRIFT" />
                        <ui:Label name="ObjectiveCopy" class="objective-copy" text="Locate viable resources and maintain ship energy above critical threshold." />

                        <ui:Label class="group-label" text="PRIMARY DIRECTIVE" />
                        <ui:VisualElement class="objective-row objective-active">
                            <ui:Label class="objective-index" text="01" />
                            <ui:Label class="objective-text" text="Survey NEREID-04" />
                            <ui:Label class="objective-state" text="ACTIVE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="objective-row">
                            <ui:Label class="objective-index" text="02" />
                            <ui:Label class="objective-text" text="Acquire raw material" />
                            <ui:Label class="objective-state" text="PENDING" />
                        </ui:VisualElement>
                        <ui:VisualElement class="objective-row">
                            <ui:Label class="objective-index" text="03" />
                            <ui:Label class="objective-text" text="Restore fuel reserve" />
                            <ui:Label class="objective-state" text="PENDING" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:VisualElement name="MissionStatusBlock" class="mission-block">
                            <ui:Label class="group-label" text="MISSION STATUS" />
                            <ui:VisualElement class="mission-line">
                                <ui:Label class="mission-key" text="TARGET" />
                                <ui:Label class="mission-value" text="ACQUIRED" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mission-line">
                                <ui:Label class="mission-key" text="READINESS" />
                                <ui:VisualElement class="mission-value-row">
                                    <ui:Label class="mission-value" text="72%" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mini-track mission-track">
                                <ui:VisualElement class="mini-fill" style="width: 72%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Screen 02: Preparation / Expedition Preparation (Phase 03) -->
            <ui:VisualElement name="PreparationScreen" class="screen preparation-screen">
                <!-- Top system bar (Phase 02 language) -->
                <ui:VisualElement class="prep-topbar">
                    <ui:VisualElement class="topbar-left">
                        <ui:Label class="topbar-brand" text="SURVIVE // DRIFT" />
                        <ui:VisualElement class="topbar-divider-v" />
                        <ui:Label class="topbar-role" text="EXPEDITION CONTROL" />
                    </ui:VisualElement>
                    <ui:VisualElement class="topbar-right">
                        <ui:Label class="topbar-cell" text="SHIP // ARK-07" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:Label class="topbar-cell" text="CYCLE 1842" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:VisualElement class="topbar-system">
                            <ui:VisualElement class="status-dot" />
                            <ui:Label class="topbar-cell" text="SYSTEM ONLINE" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Mission / target summary -->
                <ui:VisualElement name="MissionSummary" class="mission-summary">
                    <ui:VisualElement class="mission-head">
                        <ui:Label class="eyebrow" text="MISSION" />
                        <ui:Label name="PreparationDestination" class="mission-planet" text="NEREID-04" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission-data">
                        <ui:VisualElement class="mission-cell">
                            <ui:Label class="mission-cell-key" text="TARGET CLASS" />
                            <ui:Label class="mission-cell-value" text="UNKNOWN SURFACE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mission-cell">
                            <ui:Label class="mission-cell-key" text="DISTANCE" />
                            <ui:Label class="mission-cell-value" text="2.47 AU" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mission-cell">
                            <ui:Label class="mission-cell-key" text="MISSION TYPE" />
                            <ui:Label class="mission-cell-value" text="RESOURCE SURVEY" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mission-cell">
                            <ui:Label class="mission-cell-key" text="SIGNAL" />
                            <ui:Label class="mission-cell-value" text="STABLE" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main body: environment / equipment / cargo-readiness -->
                <ui:VisualElement class="preparation-body">
                    <!-- LEFT: environment -->
                    <ui:VisualElement name="EnvironmentPanel" class="prep-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="ENVIRONMENT" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:Label class="env-name" text="TEMPERATURE" />
                            <ui:Label class="env-value" text="-37 C" />
                            <ui:Label class="env-risk" text="LOW" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:Label class="env-name" text="GRAVITY" />
                            <ui:Label class="env-value" text="0.72 G" />
                            <ui:Label class="env-risk" text="STABLE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:Label class="env-name" text="RADIATION" />
                            <ui:Label class="env-value" text="MEDIUM" />
                            <ui:Label class="env-risk env-risk-caution" text="CAUTION" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:Label class="env-name" text="ATMOSPHERE" />
                            <ui:Label class="env-value" text="THIN" />
                            <ui:Label class="env-risk" text="LOW" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:Label class="env-name" text="SURFACE" />
                            <ui:Label class="env-value" text="UNKNOWN" />
                            <ui:Label class="env-risk env-risk-na" text="N/A" />
                        </ui:VisualElement>
                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="SURVEY DATA // PROVISIONAL" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: equipment / loadout -->
                    <ui:VisualElement name="EquipmentPanel" class="prep-col-center">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="EQUIPMENT // LOADOUT" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Button name="HarvesterRowButton" class="equipment-row row-required">
                            <ui:Label class="equipment-index" text="01" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="HARVESTER MK-I" />
                                <ui:Label class="equipment-purpose" text="Deployable extraction unit for mineral recovery." />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:Label class="equipment-weight" text="45 KG" />
                                <ui:Label class="equipment-chip" text="REQUIRED" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="BatteryRowButton" class="equipment-row">
                            <ui:Label class="equipment-index" text="02" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="BATTERY PACK" />
                                <ui:Label class="equipment-purpose" text="Auxiliary power reserve for remote equipment." />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:Label class="equipment-weight" text="25 KG" />
                                <ui:Label class="equipment-chip" text="OPTIONAL" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="DroneRowButton" class="equipment-row">
                            <ui:Label class="equipment-index" text="03" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="SURVEY DRONE" />
                                <ui:Label class="equipment-purpose" text="Short-range terrain and resource scanner." />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:Label class="equipment-weight" text="20 KG" />
                                <ui:Label class="equipment-chip" text="OPTIONAL" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:VisualElement class="loadout-hint">
                            <ui:Label class="loadout-hint-text" text="REQUIRED MODULES SHOWN FIRST // CONFIRM LOCKS PACKAGE" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: cargo / readiness -->
                    <ui:VisualElement class="prep-col-right">
                        <ui:VisualElement name="CargoPanel" class="panel-block">
                            <ui:VisualElement class="panel-header">
                                <ui:Label class="panel-header-text" text="CARGO" />
                                <ui:VisualElement class="panel-header-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cargo-line">
                                <ui:Label name="CargoValue" class="cargo-value" text="45 / 100" />
                                <ui:Label class="cargo-unit" text="KG" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cargo-track">
                                <ui:VisualElement name="CargoBarFill" class="cargo-fill" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="ReadinessPanel" class="panel-block readiness-block">
                            <ui:VisualElement class="panel-header">
                                <ui:Label class="panel-header-text" text="MISSION READINESS" />
                                <ui:VisualElement class="panel-header-rule" />
                            </ui:VisualElement>
                            <ui:Label name="LoadoutStateLabel" class="readiness-status" text="READY" />
                            <ui:Label class="readiness-sub" text="VALID PACKAGE // AWAITING CONFIRMATION" />
                            <ui:VisualElement class="readiness-row">
                                <ui:Label class="readiness-key" text="TARGET DATA" />
                                <ui:Label class="readiness-value" text="READY" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:Label class="readiness-key" text="HARVESTER" />
                                <ui:Label class="readiness-value" text="READY" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:Label class="readiness-key" text="POWER" />
                                <ui:Label name="ReadinessPowerValue" class="readiness-value" text="OPTIONAL" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:Label class="readiness-key" text="SURVEY" />
                                <ui:Label name="ReadinessSurveyValue" class="readiness-value" text="OPTIONAL" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:Label class="readiness-key" text="CARGO" />
                                <ui:Label name="ReadinessCargoValue" class="readiness-value" text="45 KG" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Bottom action strip -->
                <ui:VisualElement class="prep-actionbar">
                    <ui:Label class="actionbar-context" text="EXPEDITION PACKAGE" />
                    <ui:Button name="ConfirmLoadoutButton" class="confirm-action" text="CONFIRM LOADOUT" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Screen 03: Processing (Phase 01 placeholder; kept basic) -->
            <ui:VisualElement name="ProcessingScreen" class="screen screen-pad">
                <ui:Label class="app-title" text="RESOURCE PROCESSING" />
                <ui:Label class="section-title" text="RAW MINERALS" />
                <ui:Label name="ProcessingMineralsValue" class="big-value" text="0" />
                <ui:Label class="section-title" text="REFINERY FLOW" />
                <ui:VisualElement class="schematic">
                    <ui:Label class="schematic-box" text="MINERAL ORE" />
                    <ui:Label class="schematic-flow" text="|" />
                    <ui:Label class="schematic-flow" text="v" />
                    <ui:Label class="schematic-box" text="REFINERY" />
                    <ui:VisualElement class="schematic-row">
                        <ui:VisualElement class="schematic-half">
                            <ui:Label class="schematic-flow" text="v" />
                            <ui:Label class="schematic-box" text="FUEL" />
                        </ui:VisualElement>
                        <ui:VisualElement class="schematic-half">
                            <ui:Label class="schematic-flow" text="v" />
                            <ui:Label class="schematic-box" text="ALLOY" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label class="section-title" text="CURRENT OUTPUT" />
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="FUEL" />
                    <ui:Label name="ProcessingFuelValue" class="stat-value" text="0" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="ALLOY" />
                    <ui:Label name="ProcessingAlloyValue" class="stat-value" text="0" />
                </ui:VisualElement>
                <ui:Button name="ProcessButton" class="button-primary" text="PROCESS 5 MINERALS" />
            </ui:VisualElement>

            <!-- Screen 04: Outpost (Phase 01 placeholder; kept basic) -->
            <ui:VisualElement name="OutpostScreen" class="screen screen-pad">
                <ui:Label class="app-title" text="OUTPOST" />
                <ui:Label class="app-subtitle" text="CORE MODULE" />
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="HARVESTER" />
                    <ui:Label name="HarvesterLevelValue" class="stat-value" text="HARVESTER LV.1" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="REFINERY" />
                    <ui:Label name="RefineryLevelValue" class="stat-value" text="REFINERY LV.1" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="OUTPOST" />
                    <ui:Label name="OutpostLevelValue" class="stat-value" text="OUTPOST LV.1" />
                </ui:VisualElement>
                <ui:Label class="section-title" text="ALLOY STOCK" />
                <ui:VisualElement class="stat-row">
                    <ui:Label class="stat-name" text="ALLOY" />
                    <ui:Label name="OutpostAlloyValue" class="stat-value" text="0" />
                </ui:VisualElement>
                <ui:Button name="UpgradeRefineryButton" class="button-primary" text="UPGRADE REFINERY" />
                <ui:Label class="dialog-message" text="COST: 3 ALLOY" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom navigation (always available, active state via tab-active class) -->
        <ui:VisualElement name="BottomNav" class="bottom-nav">
            <ui:Button name="NavOverview" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="01" />
                <ui:Label class="nav-label" text="OVERVIEW" />
            </ui:Button>
            <ui:Button name="NavPreparation" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="02" />
                <ui:Label class="nav-label" text="PREPARATION" />
            </ui:Button>
            <ui:Button name="NavProcessing" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="03" />
                <ui:Label class="nav-label" text="PROCESSING" />
            </ui:Button>
            <ui:Button name="NavOutpost" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="04" />
                <ui:Label class="nav-label" text="OUTPOST" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Debug panel (developer-only; hidden by default, F12 reveals it) -->
        <ui:VisualElement name="DebugPanel" class="debug-panel" style="display: none;">
            <ui:Button name="DebugToggleButton" class="debug-toggle" text="DEBUG" />
            <ui:VisualElement name="DebugContent" style="display: none;">
                <ui:Button name="DebugAddMineralsButton" class="debug-button" text="+10 MINERALS" />
                <ui:Button name="DebugAddAlloyButton" class="debug-button" text="+10 ALLOY" />
                <ui:Button name="DebugResetSessionButton" class="debug-button" text="RESET SESSION" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
