<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="AppRoot" class="app-root">
        <ui:VisualElement name="AppBody" class="app-body">
            <!-- ============================================================
                 Screen 01: Overview  (Phase 02 main visual)
                 Layout: top system bar / three columns / planet stage / CTA
                 ============================================================ -->
            <ui:VisualElement name="OverviewScreen" class="screen overview-screen">
                <!-- Top system bar -->
                <ui:VisualElement name="OverviewTopBar" class="overview-topbar">
                    <ui:VisualElement class="topbar-left">
                        <ui:Label class="topbar-brand" text="SURVIVE // DRIFT" />
                        <ui:VisualElement class="topbar-divider-v" />
                        <ui:Label class="topbar-role" text="远征控制" />
                    </ui:VisualElement>
                    <ui:VisualElement class="topbar-right">
                        <ui:Label class="topbar-cell" text="SHIP // ARK-07" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:Label class="topbar-cell" text="CYCLE 1842" />
                        <ui:VisualElement class="topbar-cellsep" />
                        <ui:VisualElement class="topbar-system">
                            <ui:VisualElement class="status-dot" />
                            <ui:Label class="topbar-cell" text="SYSTEM ONLINE" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main three-column body -->
                <ui:VisualElement class="overview-body">
                    <!-- LEFT: Ship status -->
                    <ui:VisualElement name="ShipStatusPanel" class="overview-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="舰船状态" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Label class="group-label" text="生存指标" />
                        <ui:VisualElement name="ShipSurvivalGroup" class="survival-group">
                            <ui:VisualElement class="survival-row">
                                <ui:VisualElement class="survival-marker" />
                                <ui:Label class="survival-name" text="能源" />
                                <ui:VisualElement class="bar-track">
                                    <ui:VisualElement name="EnergyBarFill" class="bar-fill" />
                                </ui:VisualElement>
                                <ui:Label name="EnergyValue" class="survival-value" text="0" />
                                <ui:Label class="survival-unit" text="%" />
                            </ui:VisualElement>
                            <ui:VisualElement class="survival-row">
                                <ui:VisualElement class="survival-marker" />
                                <ui:Label class="survival-name" text="食物" />
                                <ui:VisualElement class="bar-track">
                                    <ui:VisualElement name="FoodBarFill" class="bar-fill" />
                                </ui:VisualElement>
                                <ui:Label name="FoodValue" class="survival-value" text="0" />
                                <ui:Label class="survival-unit" text="%" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="资源库存" />
                        <ui:VisualElement name="ShipResourceGroup" class="resource-group">
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="矿物" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="MineralsValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="燃料" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="FuelValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="resource-row">
                                <ui:Label class="resource-name" text="合金" />
                                <ui:VisualElement class="resource-rule" />
                                <ui:Label name="AlloyValue" class="resource-value" text="0" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="舰船系统 // 正常" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: Destination main visual -->
                    <ui:VisualElement name="DestinationPanel" class="overview-col-center">
                        <ui:Label class="eyebrow" text="当前目的地" />
                        <ui:Label name="DestinationValue" class="hero-title" text="NEREID-04" />
                        <ui:VisualElement class="hero-meta">
                            <ui:Label class="hero-meta-chip" text="未知地表" />
                            <ui:VisualElement class="chip-dot" />
                            <ui:Label class="hero-meta-chip" text="资源候选区" />
                        </ui:VisualElement>

                        <ui:VisualElement name="PlanetStage" class="planet-stage">
                            <ui:VisualElement class="planet-wrap">
                                <ui:VisualElement class="orbit-ring-outer" />
                                <ui:VisualElement class="orbit-ring" />
                                <ui:VisualElement class="planet-halo" />
                                <ui:VisualElement name="PlanetDisc" class="planet-disc" />
                                <ui:VisualElement class="corner-bracket corner-tl" />
                                <ui:VisualElement class="corner-bracket corner-tr" />
                                <ui:VisualElement class="corner-bracket corner-bl" />
                                <ui:VisualElement class="corner-bracket corner-br" />
                            </ui:VisualElement>
                            <ui:VisualElement class="planet-rail rail-left">
                                <ui:Label class="annotation-label" text="ORBITAL SURVEY" />
                                <ui:VisualElement class="annotation-rule" />
                                <ui:Label class="annotation-label" text="RESOURCE SIGNAL" />
                                <ui:Label class="annotation-label annotation-dim" text="LOW" />
                            </ui:VisualElement>
                            <ui:VisualElement class="planet-rail rail-right">
                                <ui:Label class="annotation-label" text="TARGET LOCK" />
                                <ui:VisualElement class="lock-line" />
                                <ui:VisualElement class="scan-meta">
                                    <ui:Label class="annotation-label" text="SCAN" />
                                    <ui:Label class="annotation-scan-value" text="73%" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mini-track">
                                    <ui:VisualElement class="mini-fill" style="width: 73%;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Button name="OpenPreparationButton" class="cta-action">
                            <ui:VisualElement class="cta-mark" />
                            <ui:Label class="cta-label" text="准备远征 »" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- RIGHT: Current objective -->
                    <ui:VisualElement name="ObjectivePanel" class="overview-col-right">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="当前任务" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Label class="objective-title" text="活下去" />
                        <ui:Label name="ObjectiveCopy" class="objective-copy" text="寻找可利用资源，并维持舰船能源高于临界阈值。" />

                        <ui:Label class="group-label" text="主要目标" />
                        <ui:VisualElement class="objective-row objective-active">
                            <ui:Label class="objective-index" text="01" />
                            <ui:Label class="objective-text" text="勘测 NEREID-04" />
                            <ui:Label class="objective-state" text="进行中" />
                        </ui:VisualElement>
                        <ui:VisualElement class="objective-row">
                            <ui:Label class="objective-index" text="02" />
                            <ui:Label class="objective-text" text="获取原始资源" />
                            <ui:Label class="objective-state" text="待处理" />
                        </ui:VisualElement>
                        <ui:VisualElement class="objective-row">
                            <ui:Label class="objective-index" text="03" />
                            <ui:Label class="objective-text" text="恢复燃料储备" />
                            <ui:Label class="objective-state" text="待处理" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:VisualElement name="MissionStatusBlock" class="mission-block">
                            <ui:Label class="group-label" text="任务状态" />
                            <ui:VisualElement class="mission-line">
                                <ui:Label class="mission-key" text="目标" />
                                <ui:Label class="mission-value" text="已锁定" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mission-line">
                                <ui:Label class="mission-key" text="准备度" />
                                <ui:VisualElement class="mission-value-row">
                                    <ui:Label class="mission-value" text="72%" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mini-track mission-track">
                                <ui:VisualElement class="mini-fill" style="width: 72%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Screen 02: Preparation / Expedition Preparation (Phase 03) -->
            <ui:VisualElement name="PreparationScreen" class="screen preparation-screen">
                <!-- No system brand strip (removed on request): the page opens on
                     its own identity (出发准备) and keeps the light canvas. -->

                <!-- Mission / target summary (the 资源 label + mineral disc were
                     removed on request: the page name carries the strip) -->
                <ui:VisualElement name="MissionSummary" class="mission-summary">
                    <ui:VisualElement class="mission-head">
                        <ui:Label name="PreparationDestination" class="mission-planet" text="出发准备" />
                        <ui:Label class="prep-subtitle" text="选择装备，配置出发方案" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main body: environment / equipment / cargo-readiness -->
                <ui:VisualElement class="preparation-body">
                    <!-- LEFT: environment -->
                    <ui:VisualElement name="EnvironmentPanel" class="prep-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="环境数据" />
                            <ui:Label class="panel-header-code" text="ENVIRONMENT" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:VisualElement class="env-state" />
                            <ui:VisualElement name="EnvTempIcon" class="env-icon" />
                            <ui:VisualElement class="env-copy">
                                <ui:Label class="env-name" text="温度" />
                                <ui:Label class="env-code" text="TEMP" />
                            </ui:VisualElement>
                            <ui:Label class="env-value" text="-37 °C" />
                            <ui:Label class="env-risk" text="低温" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:VisualElement class="env-state" />
                            <ui:VisualElement name="EnvGravityIcon" class="env-icon" />
                            <ui:VisualElement class="env-copy">
                                <ui:Label class="env-name" text="重力" />
                                <ui:Label class="env-code" text="GRAV" />
                            </ui:VisualElement>
                            <ui:Label class="env-value" text="0.72 G" />
                            <ui:Label class="env-risk" text="稳定" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:VisualElement class="env-state env-state-caution" />
                            <ui:VisualElement name="EnvRadiationIcon" class="env-icon" />
                            <ui:VisualElement class="env-copy">
                                <ui:Label class="env-name" text="辐射" />
                                <ui:Label class="env-code" text="RAD" />
                            </ui:VisualElement>
                            <ui:Label class="env-value" text="中等" />
                            <ui:Label class="env-risk env-risk-caution" text="注意" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row">
                            <ui:VisualElement class="env-state env-state-dim" />
                            <ui:VisualElement name="EnvAtmosphereIcon" class="env-icon" />
                            <ui:VisualElement class="env-copy">
                                <ui:Label class="env-name" text="大气" />
                                <ui:Label class="env-code" text="ATMO" />
                            </ui:VisualElement>
                            <ui:Label class="env-value" text="稀薄" />
                            <ui:Label class="env-risk env-risk-dim" text="—" />
                        </ui:VisualElement>
                        <ui:VisualElement class="env-row env-row-unknown">
                            <ui:VisualElement name="EnvSurfaceState" class="env-state env-state-unknown" />
                            <ui:VisualElement name="EnvSurfaceIcon" class="env-icon" />
                            <ui:VisualElement class="env-copy">
                                <ui:Label class="env-name" text="地表" />
                                <ui:Label class="env-code" text="SURF" />
                            </ui:VisualElement>
                            <ui:Label class="env-value" text="未知" />
                            <ui:Label class="env-risk env-risk-unknown" text="扫描中" />
                        </ui:VisualElement>
                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="陌生的世界，从准备开始。" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: equipment / loadout -->
                    <ui:VisualElement name="EquipmentPanel" class="prep-col-center">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="装备配置" />
                            <ui:Label class="panel-header-code" text="LOADOUT" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Button name="HarvesterRowButton" class="equipment-row row-required">
                            <ui:VisualElement class="equipment-bar" />
                            <ui:Label class="equipment-index" text="01" />
                            <ui:VisualElement name="HarvesterSketch" class="equipment-sketch" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="采集器 MK-I" />
                                <ui:Label class="equipment-purpose" text="可部署矿物采集模块" />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:VisualElement class="equipment-weight-line">
                                    <ui:Label class="equipment-weight" text="45" />
                                    <ui:Label class="equipment-weight-unit" text="KG" />
                                </ui:VisualElement>
                                <ui:Label class="equipment-chip" text="必需" />
                                <ui:Label class="equipment-equipped" text="已选择" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="BatteryRowButton" class="equipment-row">
                            <ui:VisualElement class="equipment-bar" />
                            <ui:Label class="equipment-index" text="02" />
                            <ui:VisualElement name="BatterySketch" class="equipment-sketch" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="备用电池组" />
                                <ui:Label class="equipment-purpose" text="为远程设备提供辅助能源" />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:VisualElement class="equipment-weight-line">
                                    <ui:Label class="equipment-weight" text="25" />
                                    <ui:Label class="equipment-weight-unit" text="KG" />
                                </ui:VisualElement>
                                <ui:Label class="equipment-chip" text="可选" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="DroneRowButton" class="equipment-row">
                            <ui:VisualElement class="equipment-bar" />
                            <ui:Label class="equipment-index" text="03" />
                            <ui:VisualElement name="DroneSketch" class="equipment-sketch" />
                            <ui:VisualElement class="equipment-copy">
                                <ui:Label class="equipment-name" text="勘测无人机" />
                                <ui:Label class="equipment-purpose" text="近距离地形与资源扫描" />
                            </ui:VisualElement>
                            <ui:VisualElement class="equipment-trailing">
                                <ui:VisualElement class="equipment-weight-line">
                                    <ui:Label class="equipment-weight" text="20" />
                                    <ui:Label class="equipment-weight-unit" text="KG" />
                                </ui:VisualElement>
                                <ui:Label class="equipment-chip" text="可选" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:VisualElement class="loadout-hint">
                            <ui:VisualElement class="loadout-hint-rule" />
                            <ui:Label class="loadout-hint-text" text="采集器为必需装备；确认后锁定配置。" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: cargo / readiness -->
                    <ui:VisualElement class="prep-col-right">
                        <ui:VisualElement name="CargoPanel" class="panel-block cargo-block">
                            <ui:VisualElement class="panel-header">
                                <ui:Label class="panel-header-text" text="载荷" />
                                <ui:Label class="panel-header-code" text="PAYLOAD" />
                                <ui:VisualElement class="panel-header-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cargo-line">
                                <ui:Label name="CargoValue" class="cargo-value" text="45 / 100" />
                                <ui:Label class="cargo-unit" text="KG" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cargo-track">
                                <ui:VisualElement name="CargoBarFill" class="cargo-fill" />
                                <ui:VisualElement class="cargo-tick cargo-tick-a" />
                                <ui:VisualElement class="cargo-tick cargo-tick-b" />
                                <ui:VisualElement class="cargo-tick cargo-tick-c" />
                                <ui:VisualElement class="cargo-tick cargo-tick-d" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="ReadinessPanel" class="panel-block readiness-block">
                            <ui:VisualElement class="panel-header">
                                <ui:Label class="panel-header-text" text="任务准备度" />
                                <ui:Label class="panel-header-code" text="READINESS" />
                                <ui:VisualElement class="panel-header-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement name="ReadinessState" class="readiness-state">
                                <ui:VisualElement class="readiness-state-dot" />
                                <ui:Label name="LoadoutStateLabel" class="readiness-status" text="就绪" />
                            </ui:VisualElement>
                            <ui:Label class="readiness-sub" text="配置有效 // 等待确认" />
                            <ui:VisualElement class="readiness-row row-active">
                                <ui:VisualElement class="readiness-dot" />
                                <ui:Label class="readiness-key" text="目标数据" />
                                <ui:Label class="readiness-value readiness-active" text="就绪" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row row-active">
                                <ui:VisualElement class="readiness-dot" />
                                <ui:Label class="readiness-key" text="采集器" />
                                <ui:Label class="readiness-value readiness-active" text="就绪" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:VisualElement class="readiness-dot" />
                                <ui:Label class="readiness-key" text="能源模块" />
                                <ui:Label name="ReadinessPowerValue" class="readiness-value" text="可选" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row">
                                <ui:VisualElement class="readiness-dot" />
                                <ui:Label class="readiness-key" text="勘测系统" />
                                <ui:Label name="ReadinessSurveyValue" class="readiness-value" text="可选" />
                            </ui:VisualElement>
                            <ui:VisualElement class="readiness-row row-active">
                                <ui:VisualElement class="readiness-dot" />
                                <ui:Label class="readiness-key" text="载荷" />
                                <ui:Label name="ReadinessCargoValue" class="readiness-value readiness-active" text="45 / 100" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="PrepMissionPanel" class="panel-block prep-mission-block">
                            <ui:VisualElement class="panel-header">
                                <ui:Label class="panel-header-text" text="任务清单" />
                                <ui:Button name="PrepMissionDetailsButton" class="prep-details-button" text="查看详情 ›" />
                            </ui:VisualElement>
                            <ui:Label class="prep-objective" text="□ 部署采集机   0 / 3" />
                            <ui:Label class="prep-objective" text="□ 收集矿物     0 / 20" />
                            <ui:VisualElement name="PrepMissionDetails" class="prep-mission-details">
                                <ui:Label class="prep-detail-row" text="目标数据      就绪" />
                                <ui:Label class="prep-detail-row" text="采集器        就绪" />
                                <ui:Label name="PrepDetailPower" class="prep-detail-row" text="能源模块      可选" />
                                <ui:Label name="PrepDetailSurvey" class="prep-detail-row" text="勘测系统      可选" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Bottom action strip -->
                <ui:VisualElement class="prep-actionbar">
                    <ui:Label class="actionbar-context" text="NEREID-04 · 出发准备" />
                    <ui:VisualElement class="prep-hints">
                        <ui:Label name="PrepHintDetails" class="prep-key-hint" text="[X] 详情" />
                        <ui:Label name="PrepHintNavigate" class="prep-key-hint" text="[&lt; &gt;] 选择" />
                        <ui:Label name="PrepHintBack" class="prep-key-hint" text="[B] 返回" />
                        <ui:Label name="PrepHintConfirm" class="prep-key-hint prep-key-primary" text="[A] 装备 / 卸下" />
                    </ui:VisualElement>
                    <ui:Button name="ConfirmLoadoutButton" class="confirm-action" text="确认配置" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Screen 03: Processing / Resource Processing (Phase 04; PASS 5 restructure) -->
            <ui:VisualElement name="ProcessingScreen" class="screen processing-screen">
                <!-- No system brand strip (removed on request): the page opens on
                     its own identity (资源加工) and gives the work area the frame. -->

                <!-- Screen identity strip -->
                <ui:VisualElement class="process-head">
                    <ui:VisualElement class="process-head-main">
                        <ui:Label class="process-title" text="资源加工" />
                        <ui:Label class="process-subtitle" text="RESOURCE PROCESSING" />
                    </ui:VisualElement>
                    <ui:VisualElement class="process-head-data">
                        <ui:Label class="mission-cell-key" text="精炼单元" />
                        <ui:Label class="mission-cell-value" text="REFINERY // UNIT-01" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main body: recipe list / refinery flow / inventory -->
                <ui:VisualElement class="processing-body">
                    <!-- LEFT: 加工列表 + 当前配方 + 加工数量 -->
                    <ui:VisualElement name="ProcessingRecipePanel" class="process-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="加工列表" />
                            <ui:VisualElement class="panel-header-rule" />
                            <ui:Label class="panel-header-tag" text="RECIPES" />
                        </ui:VisualElement>

                        <ui:VisualElement name="ProcessingRecipeList" class="recipe-list">
                            <ui:Button name="ProcessingRecipeRow" class="recipe-row recipe-selected">
                                <ui:VisualElement name="ProcessingRecipeIcon" class="recipe-icon" />
                                <ui:VisualElement class="recipe-text">
                                    <ui:Label name="ProcessingRecipeName" class="recipe-name" text="合金" />
                                    <ui:Label name="ProcessingRecipeFlow" class="recipe-sub" text="矿物 → 合金" />
                                </ui:VisualElement>
                                <ui:Label class="recipe-chevron" text="›" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Label class="recipe-note" text="精炼单元当前只有 1 条配方" />

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="当前配方" />
                        <ui:VisualElement class="recipe-current">
                            <ui:VisualElement name="ProcessingCurrentRecipeIcon" class="recipe-current-icon" />
                            <ui:VisualElement class="recipe-current-text">
                                <ui:Label name="ProcessingCurrentRecipeName" class="recipe-current-name" text="合金" />
                                <ui:Label name="ProcessingCurrentRecipeFlow" class="recipe-current-flow" text="矿物 ×1 → 合金 +1 · 燃料 +1" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="加工数量" />
                        <ui:VisualElement name="ProcessingQuantityRow" class="quantity-row">
                            <ui:Button name="ProcessingQuantityDown" class="quantity-arrow" text="‹" />
                            <ui:VisualElement class="quantity-box">
                                <ui:Label name="ProcessingQuantityValue" class="quantity-value" text="1" />
                                <ui:Label class="quantity-unit" text="矿物" />
                            </ui:VisualElement>
                            <ui:Button name="ProcessingQuantityUp" class="quantity-arrow quantity-arrow-up" text="›" />
                        </ui:VisualElement>
                        <ui:Label name="ProcessingQuantityHint" class="quantity-hint" text="上限 15 · 库存 20" />
                    </ui:VisualElement>

                    <!-- CENTER: refinery flow (first visual anchor) -->
                    <ui:VisualElement name="ProcessingCorePanel" class="process-col-center">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="加工进度" />
                            <ui:VisualElement class="panel-header-rule" />
                            <ui:VisualElement class="core-sys-dot" />
                            <ui:Label class="core-sys-label" text="精炼单元 · 在线" />
                        </ui:VisualElement>

                        <ui:VisualElement name="ProcessingActivityStrip" class="core-strip" />

                        <ui:VisualElement class="core-panel">
                            <!-- Main state + live progress readout -->
                            <ui:VisualElement class="core-status-row">
                                <ui:Label name="ProcessingStatusLabel" class="core-status" text="准备就绪" />
                                <ui:VisualElement class="core-progress-readout">
                                    <ui:Label class="core-progress-caption" text="加工进度" />
                                    <ui:Label name="ProcessingProgressPercent" class="core-progress-big" text="—" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Refinery flow: 矿物 -> 精炼炉 -> 燃料 / 合金 -->
                            <ui:VisualElement class="core-flow">
                                <ui:VisualElement class="flow-node flow-node-input">
                                    <ui:VisualElement name="FlowOreIcon" class="flow-icon" />
                                    <ui:Label class="flow-node-text" text="矿物" />
                                    <ui:Label class="flow-node-sub" text="原料输入" />
                                </ui:VisualElement>

                                <ui:VisualElement name="FlowLineIn" class="flow-conn" />

                                <ui:VisualElement class="flow-core">
                                    <ui:VisualElement name="RefineryCoreHost" class="refinery-core" />
                                    <ui:Label class="flow-core-text" text="精炼炉" />
                                    <ui:Label name="ProcessingCoreNote" class="flow-node-sub core-batch-note" text="待机" />
                                </ui:VisualElement>

                                <ui:VisualElement name="FlowLineOut" class="flow-conn flow-conn-out" />

                                <ui:VisualElement class="flow-output">
                                    <ui:VisualElement class="flow-node flow-node-output">
                                        <ui:VisualElement name="FlowFuelIcon" class="flow-icon" />
                                        <ui:VisualElement class="flow-output-text">
                                            <ui:Label class="flow-node-text" text="燃料" />
                                            <ui:Label class="flow-node-sub" text="副产物" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="flow-split-rule" />
                                    <ui:VisualElement class="flow-node flow-node-output">
                                        <ui:VisualElement name="FlowAlloyIcon" class="flow-icon" />
                                        <ui:VisualElement class="flow-output-text">
                                            <ui:Label class="flow-node-text" text="合金" />
                                            <ui:Label class="flow-node-sub" text="主产物" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Expected / settled output of the selected quantity -->
                            <ui:VisualElement name="ProcessingOutputPanel" class="result-panel">
                                <ui:VisualElement class="result-mark" />
                                <ui:Label name="ProcessingOutputCaption" class="result-caption" text="预计产出" />
                                <ui:Label class="output-key" text="燃料" />
                                <ui:Label name="ProcessingFuelGainValue" class="result-value" text="+1" />
                                <ui:Label class="result-sep" text="·" />
                                <ui:Label class="output-key" text="合金" />
                                <ui:Label name="ProcessingAlloyGainValue" class="result-value" text="+1" />
                            </ui:VisualElement>

                            <!-- Run progress rule -->
                            <ui:VisualElement class="core-track-row">
                                <ui:VisualElement class="progress-track">
                                    <ui:VisualElement name="ProcessingProgressFill" class="progress-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: 当前库存 + 加工效率 -->
                    <ui:VisualElement name="ProcessingInventoryPanel" class="process-col-right">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="当前库存" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-line inventory-line-raw">
                            <ui:VisualElement name="InventoryOreIcon" class="inventory-icon" />
                            <ui:Label class="inventory-key" text="矿物" />
                            <ui:Label name="ProcessingMineralsValue" class="inventory-value" text="20" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-line">
                            <ui:VisualElement name="InventoryFuelIcon" class="inventory-icon" />
                            <ui:Label class="inventory-key" text="燃料" />
                            <ui:Label name="ProcessingFuelValue" class="inventory-value" text="8" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-line">
                            <ui:VisualElement name="InventoryAlloyIcon" class="inventory-icon" />
                            <ui:Label class="inventory-key" text="合金" />
                            <ui:Label name="ProcessingAlloyValue" class="inventory-value" text="5" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="加工效率" />
                        <ui:VisualElement class="meta-line">
                            <ui:Label class="meta-key" text="模块等级" />
                            <ui:Label name="ProcessingRefineryLevel" class="meta-value" text="LV.1" />
                        </ui:VisualElement>
                        <ui:VisualElement class="meta-line">
                            <ui:Label class="meta-key" text="加工时间" />
                            <ui:Label name="ProcessingDurationValue" class="meta-value" text="2.0s" />
                        </ui:VisualElement>
                        <ui:VisualElement class="meta-line">
                            <ui:Label class="meta-key" text="产物配比" />
                            <ui:Label class="meta-value" text="1 : 1 : 1" />
                        </ui:VisualElement>
                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="1 矿物 = 合金 +1 · 燃料 +1" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Bottom action strip: B 返回 / A 确认加工 -->
                <ui:VisualElement class="process-actionbar">
                    <ui:VisualElement class="actionbar-context">
                        <ui:Label class="actionbar-label" text="REFINERY // BATCH OPERATION" />
                        <ui:Label class="actionbar-note" text="加工期间无法修改配方与数量" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ProcessingPromptHost" class="process-prompt-host" />
                    <ui:Button name="ProcessingStartButton" class="process-action" text="确认加工" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Screen 04: Outpost / Module Topology + Upgrade Economy (Phase 05;
                 controller + visual pass in Phase 09B PASS 6) -->
            <ui:VisualElement name="OutpostScreen" class="screen outpost-screen">
                <!-- Page identity: only the name, no system strip, no English -->
                <ui:VisualElement class="outpost-head">
                    <ui:Label class="outpost-title" text="据点" />
                </ui:VisualElement>

                <!-- Main body: status / topology / module detail -->
                <ui:VisualElement class="outpost-body">
                    <!-- LEFT: outpost status + alloy + construction info -->
                    <ui:VisualElement name="OutpostStatusPanel" class="outpost-col-left">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="据点状态" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="核心模块" />
                            <ui:Label name="OutpostLevelValue" class="outpost-status-value" text="LV.1" />
                        </ui:VisualElement>
                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="采集模块" />
                            <ui:Label name="HarvesterLevelValue" class="outpost-status-value" text="LV.1" />
                        </ui:VisualElement>
                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="精炼模块" />
                            <ui:Label name="RefineryLevelValue" class="outpost-status-value" text="LV.1" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="资源" />
                        <ui:VisualElement class="alloy-line">
                            <ui:Label name="OutpostAlloyValue" class="alloy-value" text="5" />
                            <ui:Label class="alloy-unit" text="合金" />
                        </ui:VisualElement>
                        <ui:Label class="alloy-hint" text="用于基地模块升级" />

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="group-label" text="建设信息" />
                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="据点等级" />
                            <ui:Label name="OutpostCapValue" class="outpost-status-value" text="LV.2" />
                        </ui:VisualElement>
                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="已建模块" />
                            <ui:Label class="outpost-status-value" text="3 / 3" />
                        </ui:VisualElement>
                        <ui:VisualElement class="outpost-status-row">
                            <ui:Label class="outpost-status-key" text="运行状态" />
                            <ui:Label class="outpost-status-value" text="正常" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-footnote">
                            <ui:VisualElement class="footnote-tick" />
                            <ui:Label class="footnote-label" text="基地网络 // 稳定" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: module topology (core -> harvester / refinery) -->
                    <ui:VisualElement name="OutpostTopology" class="outpost-col-center">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="模块升级" />
                            <ui:VisualElement class="panel-header-rule" />
                            <ui:VisualElement class="core-sys-dot" />
                            <ui:Label class="core-sys-label" text="三模块在线" />
                        </ui:VisualElement>

                        <ui:VisualElement class="topo-stage">
                            <ui:Button name="CoreModuleNode" class="outpost-node node-core">
                                <ui:VisualElement name="CoreNodeIcon" class="node-icon" />
                                <ui:VisualElement class="node-copy">
                                    <ui:VisualElement class="node-title-row">
                                        <ui:Label class="node-title" text="核心模块" />
                                        <ui:Label name="CoreNodeLevel" class="node-level" text="LV.1" />
                                    </ui:VisualElement>
                                    <ui:Label class="node-hint" text="提升子系统上限" />
                                    <ui:Label name="CoreNodeStatusValue" class="node-status" text="当前上限 LV.2" />
                                </ui:VisualElement>
                            </ui:Button>

                            <ui:VisualElement class="topo-trunk">
                                <ui:VisualElement class="topo-vline" />
                            </ui:VisualElement>
                            <ui:VisualElement class="topo-rail" />

                            <ui:VisualElement class="topo-children">
                                <ui:VisualElement class="topo-child">
                                    <ui:VisualElement class="topo-vline" />
                                    <ui:Button name="HarvesterModuleNode" class="outpost-node node-sub">
                                        <ui:VisualElement name="HarvesterNodeIcon" class="node-icon" />
                                        <ui:VisualElement class="node-copy">
                                            <ui:VisualElement class="node-title-row">
                                                <ui:Label class="node-title" text="采集模块" />
                                                <ui:Label name="HarvesterNodeLevel" class="node-level" text="LV.1" />
                                            </ui:VisualElement>
                                            <ui:Label class="node-hint" text="提升采集效率" />
                                            <ui:Label name="HarvesterNodeStatusValue" class="node-status" text="采集效率 100%" />
                                        </ui:VisualElement>
                                    </ui:Button>
                                </ui:VisualElement>
                                <ui:VisualElement class="topo-child">
                                    <ui:VisualElement class="topo-vline" />
                                    <ui:Button name="RefineryModuleNode" class="outpost-node node-sub">
                                        <ui:VisualElement name="RefineryNodeIcon" class="node-icon" />
                                        <ui:VisualElement class="node-copy">
                                            <ui:VisualElement class="node-title-row">
                                                <ui:Label class="node-title" text="精炼模块" />
                                                <ui:Label name="RefineryNodeLevel" class="node-level" text="LV.1" />
                                            </ui:VisualElement>
                                            <ui:Label class="node-hint" text="缩短加工时间" />
                                            <ui:Label name="RefineryNodeStatusValue" class="node-status" text="加工时间 2.0s" />
                                        </ui:VisualElement>
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: selected module detail + cost / condition + action -->
                    <ui:VisualElement name="OutpostDetailPanel" class="outpost-col-right">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-header-text" text="模块详情" />
                            <ui:VisualElement class="panel-header-rule" />
                        </ui:VisualElement>

                        <ui:Label name="ModuleDetailName" class="detail-name" text="精炼模块" />
                        <ui:Label name="ModuleDetailLevels" class="detail-levels" text="LV.1 ▶ LV.2" />

                        <ui:VisualElement class="panel-rule" />

                        <ui:Label class="detail-effect-title" text="升级后效果" />
                        <ui:VisualElement class="effect-line">
                            <ui:Label name="ModuleDetailEffectTitle" class="effect-key" text="加工时间" />
                            <ui:Label name="ModuleCurrentEffectValue" class="effect-value" text="2.0s" />
                            <ui:Label class="effect-arrow" text="▶" />
                            <ui:Label name="ModuleNextEffectValue" class="effect-value effect-next" text="1.6s" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ModuleSecondEffectRow" class="effect-line">
                            <ui:Label name="ModuleSecondEffectKey" class="effect-key" text="加工效率" />
                            <ui:Label name="ModuleSecondEffectCurrent" class="effect-value" text="100%" />
                            <ui:Label class="effect-arrow" text="▶" />
                            <ui:Label name="ModuleSecondEffectNext" class="effect-value effect-next" text="125%" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel-rule" />

                        <ui:VisualElement class="detail-meta-row">
                            <ui:Label class="detail-meta-key" text="升级消耗" />
                            <ui:Label name="ModuleUpgradeCostValue" class="detail-meta-value" text="3 合金" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-meta-row">
                            <ui:Label class="detail-meta-key" text="条件" />
                            <ui:Label name="ModuleUpgradeRequirement" class="detail-meta-value" text="—" />
                        </ui:VisualElement>

                        <ui:Button name="OutpostUpgradeButton" class="outpost-action" text="升级" />

                        <ui:Label class="detail-note" text="合金用于基地模块升级" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Controller key line: the shared Phase 09B prompt bar mounts
                     here (bottom-right of the page). -->
                <ui:VisualElement name="OutpostPromptHost" class="outpost-prompt-host" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom navigation (always available, active state via tab-active class) -->
        <ui:VisualElement name="BottomNav" class="bottom-nav">
            <ui:Button name="NavOverview" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="01" />
                <ui:Label class="nav-label" text="总览" />
            </ui:Button>
            <ui:Button name="NavPreparation" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="02" />
                <ui:Label class="nav-label" text="出发准备" />
            </ui:Button>
            <ui:Button name="NavProcessing" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="03" />
                <ui:Label class="nav-label" text="资源加工" />
            </ui:Button>
            <ui:Button name="NavOutpost" class="nav-button">
                <ui:VisualElement class="nav-rule-top" />
                <ui:Label class="nav-index" text="04" />
                <ui:Label class="nav-label" text="据点" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Debug panel (developer-only; hidden by default, F12 reveals it) -->
        <ui:VisualElement name="DebugPanel" class="debug-panel" style="display: none;">
            <ui:Button name="DebugToggleButton" class="debug-toggle" text="DEBUG" />
            <ui:VisualElement name="DebugContent" style="display: none;">
                <ui:Button name="DebugAddMineralsButton" class="debug-button" text="+10 MINERALS" />
                <ui:Button name="DebugAddAlloyButton" class="debug-button" text="+10 ALLOY" />
                <ui:Button name="DebugResetSessionButton" class="debug-button" text="RESET SESSION" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
