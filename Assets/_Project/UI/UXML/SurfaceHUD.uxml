<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="SurfaceHudRoot" class="hud-root">
        <!-- ============ Normal exploration layer (screen-space) ============ -->
        <ui:VisualElement name="HudLayer" class="hud-layer">
            <!-- Mission context + real resource readouts (top-left) -->
            <ui:VisualElement class="hud-card hud-context">
                <ui:VisualElement class="hud-context-line">
                    <ui:Label class="hud-title" text="NEREID-04" />
                    <ui:Label class="hud-subtitle" text="地表勘测" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-rule" />
                <ui:VisualElement class="hud-row">
                    <ui:Label class="hud-row-key" text="矿物" />
                    <ui:Label name="HudMineralsValue" class="hud-row-value" text="20" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-row">
                    <ui:Label class="hud-row-key" text="采集效率" />
                    <ui:Label name="HudEfficiencyValue" class="hud-row-value" text="100%" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-row">
                    <ui:Label class="hud-row-key" text="回收节点" />
                    <ui:Label name="HudNodesValue" class="hud-row-value" text="0 / 3" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Node status / harvest progress (left, mid-low) -->
            <ui:VisualElement name="HudStatusCard" class="hud-card hud-status">
                <ui:Label class="hud-status-label" text="加工状态" />
                <ui:VisualElement class="hud-status-line">
                    <ui:Label name="HudStatusText" class="hud-status-text" text="—" />
                    <ui:Label name="HudStatusPercent" class="hud-status-percent" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Navigation readout (left, above the interaction prompt) -->
            <ui:VisualElement name="HudNavBlock" class="hud-nav">
                <ui:Label name="HudNavName" class="hud-nav-name" text="" />
                <ui:Label name="HudNavDistance" class="hud-nav-distance" text="" />
            </ui:VisualElement>

            <!-- Interaction prompt (bottom center) -->
            <ui:Label name="HudPrompt" class="hud-prompt" text="搜寻资源节点" />

            <!-- Transfer result (center) -->
            <ui:Label name="HudResult" class="hud-result" text="" />

            <!-- Return to ship (top-right) -->
            <ui:Button name="HudReturnButton" class="hud-return" text="返回舰船" />

            <!-- Center interaction crosshair (neutral dot + optional ring) -->
            <ui:VisualElement class="hud-crosshair-wrap">
                <ui:VisualElement name="HudCrosshairDot" class="hud-xh-dot" />
                <ui:VisualElement name="HudCrosshairRing" class="hud-xh-ring" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Wrist-mode custom dot cursor (screen-space overlay, above HUD;
             picking ignored so it never blocks the world display hit-test) -->
        <ui:VisualElement name="WristCursorOverlay" class="wrist-os-cursor" />
    </ui:VisualElement>
</ui:UXML>
