/*
 * Survive UI Demo - Overview screen layout (Phase 02; PASS 7 visual upgrade).
 * Loaded after AppTheme.uss. Coordinates target the 1920x1080 reference.
 *
 * PASS 7 direction (user's sketch + approved reference):
 *   - light canvas only (white / light gray), one restrained cyan accent;
 *   - one Chinese page title instead of the old decorative English system strip;
 *   - the planet stays the page's first visual, with rings, a lock frame and the
 *     exploration read-out next to it;
 *   - the controller key line lives at the bottom of the page and only ever
 *     lists keys this page really has.
 */

/* ---------- Screen / page title ---------- */

.overview-screen {
    flex-direction: column;
}

.overview-topbar {
    flex-shrink: 0;
    height: 92px;
    flex-direction: row;
    align-items: center;
    padding-left: 64px;
    padding-right: 64px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.overview-title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #161B20;
}

/* One short accent rule next to the title: page identity, nothing decorative. */
.overview-title-rule {
    width: 44px;
    height: 3px;
    background-color: #0E7F8C;
    margin-left: 20px;
}

/* ---------- Main three-column body ---------- */

.overview-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
    padding-top: 36px;
    padding-bottom: 22px;
    padding-left: 64px;
    padding-right: 64px;
}

.overview-col-left {
    width: 352px;
    flex-shrink: 0;
    flex-direction: column;
    padding-right: 36px;
    border-right-width: 1px;
    border-right-color: #DEE2E5;
}

.overview-col-center {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding-left: 34px;
    padding-right: 34px;
}

.overview-col-right {
    width: 400px;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 36px;
    border-left-width: 1px;
    border-left-color: #DEE2E5;
}

/* ---------- Shared section primitives ---------- */

.panel-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.panel-header-text {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #161B20;
}

.panel-header-rule {
    flex-grow: 1;
    height: 1px;
    background-color: #C9CFD4;
    margin-left: 22px;
}

.group-label {
    font-size: 10px;
    letter-spacing: 0px;
    color: #5A6570;
    margin-bottom: 6px;
}

.panel-rule {
    height: 1px;
    background-color: #C9CFD4;
    margin-top: 26px;
    margin-bottom: 26px;
}

/* ---------- Left column: survival bars ---------- */

.survival-group {
    flex-direction: column;
}

.survival-row {
    flex-direction: row;
    align-items: center;
    height: 58px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.survival-marker {
    width: 5px;
    height: 5px;
    background-color: #0E7F8C;
    margin-right: 14px;
}

.survival-name {
    font-size: 12px;
    letter-spacing: 0px;
    color: #4A525C;
    width: 74px;
}

.bar-track {
    flex-grow: 1;
    height: 4px;
    background-color: #D3D8DC;
    margin-left: 16px;
    margin-right: 18px;
}

.bar-fill {
    height: 4px;
    width: 0%;
    background-color: #161B20;
}

.survival-value {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #161B20;
    min-width: 44px;
    -unity-text-align: middle-right;
}

.survival-unit {
    font-size: 12px;
    color: #7B858F;
    margin-left: 5px;
}

/* ---------- Left column: resource inventory ---------- */

.resource-group {
    flex-direction: column;
}

.resource-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
}

.resource-name {
    font-size: 12px;
    letter-spacing: 0px;
    color: #4A525C;
}

.resource-rule {
    flex-grow: 1;
    height: 1px;
    background-color: #DEE2E5;
    margin-left: 18px;
    margin-right: 18px;
    margin-bottom: 6px;
}

.resource-value {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #161B20;
    min-width: 36px;
    -unity-text-align: middle-right;
}

.panel-footnote {
    flex-direction: row;
    align-items: center;
    margin-top: 40px;
}

.footnote-tick {
    width: 6px;
    height: 6px;
    background-color: #C9CFD4;
    margin-right: 10px;
}

.footnote-label {
    font-size: 10px;
    letter-spacing: 0px;
    color: #9AA2AA;
}

/* ---------- Center column: planet hero ---------- */

.eyebrow {
    font-size: 11px;
    letter-spacing: 0px;
    color: #7B858F;
    margin-top: 4px;
}

.hero-title {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: #161B20;
    margin-top: 10px;
}

.hero-meta {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.hero-meta-chip {
    font-size: 13px;
    letter-spacing: 0px;
    color: #7B858F;
}

.chip-dot {
    width: 4px;
    height: 4px;
    background-color: #0E7F8C;
    margin-left: 18px;
    margin-right: 18px;
}

/* ---------- Center column: planet stage ---------- */

.planet-stage {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
}

.planet-wrap {
    width: 540px;
    height: 540px;
    flex-shrink: 0;
    position: relative;
}

.planet-disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 400px;
    height: 400px;
    margin-left: -200px;
    margin-top: -200px;
}

.planet-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 432px;
    height: 432px;
    margin-left: -216px;
    margin-top: -216px;
    border-width: 1px;
    border-color: rgba(14, 127, 140, 0.28);
    border-radius: 216px;
}

.orbit-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 478px;
    height: 478px;
    margin-left: -239px;
    margin-top: -239px;
    border-width: 1px;
    border-color: rgba(123, 133, 143, 0.34);
    border-radius: 239px;
}

.orbit-ring-outer {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 516px;
    height: 516px;
    margin-left: -258px;
    margin-top: -258px;
    border-width: 1px;
    border-color: rgba(123, 133, 143, 0.15);
    border-radius: 258px;
}

/* Planet bounding registration marks (the "lock frame" of the sketch). */
.corner-bracket {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
}

.corner-tl {
    margin-left: -200px;
    margin-top: -200px;
    border-top-width: 1px;
    border-top-color: rgba(74, 82, 92, 0.85);
    border-left-width: 1px;
    border-left-color: rgba(74, 82, 92, 0.85);
}

.corner-tr {
    margin-left: 174px;
    margin-top: -200px;
    border-top-width: 1px;
    border-top-color: rgba(74, 82, 92, 0.85);
    border-right-width: 1px;
    border-right-color: rgba(74, 82, 92, 0.85);
}

.corner-bl {
    margin-left: -200px;
    margin-top: 174px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 82, 92, 0.85);
    border-left-width: 1px;
    border-left-color: rgba(74, 82, 92, 0.85);
}

.corner-br {
    margin-left: 174px;
    margin-top: 174px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 82, 92, 0.85);
    border-right-width: 1px;
    border-right-color: rgba(74, 82, 92, 0.85);
}

/* Four sparse cyan axis ticks on the rings: orientation, not decoration. */
.axis-tick {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 1px;
    background-color: rgba(14, 127, 140, 0.55);
}

.tick-n {
    margin-left: -4px;
    margin-top: -258px;
    width: 9px;
    height: 7px;
}

.tick-s {
    margin-left: -4px;
    margin-top: 251px;
    width: 9px;
    height: 7px;
}

.tick-w {
    margin-left: -258px;
    margin-top: -3px;
    width: 7px;
    height: 9px;
}

.tick-e {
    margin-left: 251px;
    margin-top: -3px;
    width: 7px;
    height: 9px;
}

/* ---------- Center column: planet side rails ---------- */

.planet-rail {
    width: 176px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
}

.rail-left {
    align-items: flex-end;
    padding-right: 22px;
}

.rail-right {
    align-items: flex-start;
    padding-left: 22px;
}

.rail-key {
    font-size: 11px;
    letter-spacing: 0px;
    color: #7B858F;
}

.rail-value {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #161B20;
    margin-top: 5px;
}

.rail-rule {
    width: 108px;
    height: 1px;
    background-color: #DEE2E5;
    margin-top: 16px;
    margin-bottom: 16px;
}

/* Exploration read-out: value first, then a simple accent bar. */
.exploration-value {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #161B20;
    margin-top: 4px;
}

.exploration-track {
    width: 168px;
    height: 4px;
    background-color: #D3D8DC;
    margin-top: 12px;
}

.exploration-fill {
    height: 4px;
    width: 0%;
    background-color: #0E7F8C;
}

/* ---------- Center column: primary CTA (Hub host only) ---------- */

.cta-action {
    flex-shrink: 0;
    width: 460px;
    height: 60px;
    flex-direction: row;
    align-items: center;
    padding-left: 28px;
    margin-top: 16px;
    margin-bottom: 4px;
    background-color: #161B20;
    border-width: 1px;
    border-color: #161B20;
    transition-property: background-color, border-color;
    transition-duration: 0.13s;
}

.cta-action:hover {
    background-color: #0E7F8C;
    border-color: #0E7F8C;
}

.cta-action:active {
    background-color: #0A616C;
    border-color: #0A616C;
}

.cta-mark {
    width: 10px;
    height: 10px;
    background-color: #FFFFFF;
    margin-right: 22px;
}

.cta-action:hover .cta-mark {
    background-color: #0A616C;
}

.cta-label {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #FFFFFF;
}

/* ---------- Controller key line (shared Phase 09B prompt bar) ---------- */

.overview-prompt-host {
    flex-shrink: 0;
    width: 100%;
    height: 58px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

/* ---------- Right column: objective + mission status ---------- */

.objective-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #161B20;
    margin-bottom: 10px;
}

.objective-copy {
    font-size: 14px;
    color: #4A525C;
    white-space: normal;
    width: 100%;
    margin-bottom: 32px;
}

.objective-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.objective-index {
    width: 44px;
    font-size: 14px;
    letter-spacing: 2px;
    color: #7B858F;
}

.objective-text {
    flex-grow: 1;
    font-size: 13px;
    letter-spacing: 1px;
    color: #161B20;
}

.objective-state {
    font-size: 10px;
    letter-spacing: 0px;
    color: #9AA2AA;
}

.objective-active .objective-index {
    color: #0E7F8C;
    -unity-font-style: bold;
}

.objective-active .objective-text {
    -unity-font-style: bold;
}

.objective-active .objective-state {
    color: #0E7F8C;
}

.mission-block {
    flex-direction: column;
}

.mission-line {
    flex-direction: row;
    align-items: center;
    height: 36px;
}

.mission-key {
    font-size: 11px;
    letter-spacing: 0px;
    color: #7B858F;
}

.mission-value {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0px;
    color: #161B20;
}

.mission-value-row {
    margin-left: auto;
}

.mission-track {
    width: 100%;
    margin-top: 8px;
}

.mini-track {
    height: 3px;
    background-color: #D3D8DC;
}

.mini-fill {
    height: 3px;
    background-color: #0E7F8C;
}

/* =====================================================================
 * Project cursor, document-wide (Phase 09B PASS 6 follow-up).
 *
 * UI Toolkit re-applies the hovered element's own cursor on every hover
 * change. Every document (hub app, ship HUD, surface HUD / wrist, main menu,
 * warehouse console, modal sheets) therefore carries the project's dot, so no
 * element can ever resolve to the stock Windows arrow. Actionable elements
 * override it with the dot+ring asset where a page defines them.
 * ===================================================================== */

* {
    cursor: url("../Cursors/T_CursorDot.png") 16 16;
}
