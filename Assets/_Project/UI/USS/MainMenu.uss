/* ============================================================
   Phase 08 Revision 2 — TITLE SCREEN
   Loaded after AppTheme.uss. Coordinates target the 1920x1080 reference.

   Rules for this screen:
   - The screen IS the shot: deep space + the hero ship on the left come from
     the scene camera, so almost nothing here is painted. No top bar, no
     footer, no telemetry, no card background, no HUD brackets.
   - Only two things are drawn: the right-hand menu block and the black
     transition overlay (plus the 选项 modal while it is open).
   - Focus is the primary state, not hover: the focused row brightens, gains a
     marker and a hairline accent. It never becomes a heavy filled button.
   ============================================================ */

/* ---------- Shell ---------- */

.main-menu-root {
    flex-grow: 1;
    flex-direction: row;
    /* Fully transparent: a window onto the 3D stage, not a canvas. */
    background-color: rgba(0, 0, 0, 0);
}

.menu-layer {
    flex-grow: 1;
    flex-direction: row;
}

/* LEFT: the hero window. Nothing is painted here. */
.menu-hero {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* RIGHT: title + menu, floating directly in the starfield. */
.menu-column {
    width: 36%;
    flex-direction: column;
    justify-content: center;
    padding-right: 96px;
    padding-left: 24px;
}

/* ---------- Title ---------- */

.menu-title {
    color: #F4F9FD;
    font-size: 76px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 42px;
}

/* ---------- Menu list ---------- */

.menu-list {
    flex-direction: column;
}

.menu-item {
    height: 62px;
    flex-direction: row;
    align-items: center;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.menu-item-marker {
    width: 26px;
    color: rgba(120, 216, 236, 0);
    font-size: 30px;
    -unity-text-align: middle-left;
}

.menu-item-label {
    color: #9EB2C2;
    font-size: 30px;
    letter-spacing: 3px;
}

/* Focused row: clearly the current selection, still restrained. */
.menu-item-focused {
    border-left-color: #4FD4E6;
}

.menu-item-focused .menu-item-marker {
    color: #4FD4E6;
}

.menu-item-focused .menu-item-label {
    color: #FFFFFF;
}

/* Unavailable row (继续游戏 with no resumable run): weaker, still readable. */
.menu-item-disabled .menu-item-label {
    color: rgba(158, 178, 194, 0.38);
}

.menu-item-disabled .menu-item-marker {
    color: rgba(0, 0, 0, 0);
}

.menu-item:hover .menu-item-label {
    color: #DCE9F2;
}

/* ---------- Controller hint ---------- */

.input-hint {
    margin-top: 42px;
    color: rgba(168, 196, 212, 0.82);
    font-size: 16px;
    letter-spacing: 2px;
}

/* ---------- Options modal ---------- */

.menu-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.menu-modal-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 5, 9, 0.72);
}

.menu-modal-panel {
    width: 520px;
    flex-direction: column;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 28px;
    padding-bottom: 26px;
    background-color: #0B141C;
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.24);
    border-radius: 3px;
}

.menu-modal-title {
    color: #F2F8FC;
    font-size: 30px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.menu-modal-rule {
    height: 1px;
    margin-top: 20px;
    margin-bottom: 22px;
    background-color: rgba(140, 200, 220, 0.18);
}

.menu-setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.menu-setting-name {
    color: #E4EEF5;
    font-size: 20px;
    letter-spacing: 1px;
}

.menu-segment {
    flex-direction: row;
}

.menu-segment-button {
    width: 72px;
    height: 34px;
    margin-left: 8px;
    color: #C6D8E2;
    font-size: 15px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(140, 190, 210, 0.22);
    border-radius: 2px;
}

.menu-segment-button:hover {
    background-color: rgba(120, 200, 225, 0.16);
}

.menu-segment-button.segment-active {
    color: #04161C;
    background-color: #17AEC4;
    border-color: #17AEC4;
}

.menu-modal-close {
    width: 100%;
    height: 42px;
    color: #CFE3EC;
    font-size: 17px;
    letter-spacing: 2px;
    background-color: rgba(120, 200, 225, 0.10);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.26);
    border-radius: 2px;
}

.menu-modal-close:hover {
    background-color: rgba(120, 200, 225, 0.20);
}

/* ---------- Start cinematic blackout ---------- */

.menu-transition {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
    opacity: 0;
}
