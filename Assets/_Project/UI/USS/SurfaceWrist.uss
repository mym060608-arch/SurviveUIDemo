/*
 * Survive UI Demo - NEREID-04 wrist terminal (Phase 06 Revision CodeReference).
 * Rendered into a fixed 1280x800 RenderTexture and projected onto a tilted
 * world plane. Off-white / ink / teal / hairline language, no neon.
 *
 * IMPORTANT: this sheet is ONLY responsible for text/marker placement.
 * It must NOT draw rings, arcs, functional sectors or a white map disc:
 * every annular shape comes from RadialWristElement triangle meshes.
 */

.wrist-root {
    position: relative;

    width: 1280px;
    height: 800px;

    background-color: rgba(0, 0, 0, 0);
}

.radial-geometry-host {
    position: absolute;

    left: 0;
    top: 0;

    width: 1280px;
    height: 800px;

    background-color: rgba(0, 0, 0, 0);
}

.map-marker-layer {
    position: absolute;

    left: 0;
    top: 0;

    width: 1280px;
    height: 800px;

    background-color: rgba(0, 0, 0, 0);
}

.radial-value {
    position: absolute;

    color: rgb(22, 27, 32);

    font-size: 17px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.health-label {
    left: 545px;
    top: 56px;

    width: 190px;
    height: 32px;
}

.satiety-label {
    left: 545px;
    top: 710px;

    width: 190px;
    height: 32px;
}

/* ============================================================
   Functional sector text.

   CRITICAL:
   These have NO card background.
   Geometry comes from RadialWristElement.
   ============================================================ */

.sector-content {
    position: absolute;

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* Mid-angle ~162 deg */
.equip-content {
    left: 238px;
    top: 240px;

    width: 220px;
    height: 112px;
}

/* Mid-angle ~17 deg */
.state-content {
    left: 822px;
    top: 240px;

    width: 220px;
    height: 112px;
}

/* Mid-angle ~215 deg */
.nav-content {
    left: 260px;
    top: 520px;

    width: 220px;
    height: 105px;
}

/* Mid-angle ~325 deg */
.harvest-content {
    left: 800px;
    top: 520px;

    width: 220px;
    height: 105px;
}

.sector-heading {
    color: rgb(74, 82, 92);

    font-size: 12px;
    -unity-font-style: bold;

    margin-bottom: 7px;
}

.sector-line {
    color: rgb(22, 27, 32);

    font-size: 12px;

    margin-top: 2px;
    margin-bottom: 2px;
}

.sector-value {
    color: rgb(14, 127, 140);

    -unity-font-style: bold;
}

/* Equipment items that are NOT selected are muted but still listed. */
.sector-line.sector-off {
    color: rgb(126, 136, 144);
}

/* ============================================================
   Map markers.
   ============================================================ */

.map-node {
    position: absolute;

    width: 24px;
    height: 24px;

    margin-left: -12px;
    margin-top: -12px;

    background-color: rgb(22, 27, 32);

    border-radius: 12px;
}

.map-node.node-depleted {
    background-color: rgba(22, 27, 32, 0);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;

    border-left-color: rgb(110, 122, 130);
    border-right-color: rgb(110, 122, 130);
    border-top-color: rgb(110, 122, 130);
    border-bottom-color: rgb(110, 122, 130);
}

.map-node.node-active {
    background-color: rgb(14, 127, 140);
}

.map-node.node-transmitting {
    background-color: rgb(10, 97, 108);
}

.map-node.node-selected {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;

    border-left-color: rgb(14, 127, 140);
    border-right-color: rgb(14, 127, 140);
    border-top-color: rgb(14, 127, 140);
    border-bottom-color: rgb(14, 127, 140);
}

/* Player marker: native triangle glyph (points north at yaw 0); C# rotates
   it by player yaw so the marker always shows facing. */
.map-player {
    position: absolute;

    width: 22px;
    height: 22px;

    margin-left: -11px;
    margin-top: -11px;

    -unity-text-align: middle-center;

    color: rgb(14, 127, 140);

    font-size: 16px;
    -unity-font-style: bold;
}

/* Landing/return point: thin outlined square. */
.map-landing {
    position: absolute;

    width: 18px;
    height: 18px;

    margin-left: -9px;
    margin-top: -9px;

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;

    border-left-color: rgb(74, 82, 92);
    border-right-color: rgb(74, 82, 92);
    border-top-color: rgb(74, 82, 92);
    border-bottom-color: rgb(74, 82, 92);
}

.map-selected-ring {
    position: absolute;

    width: 36px;
    height: 36px;

    margin-left: -18px;
    margin-top: -18px;

    background-color: rgba(0, 0, 0, 0);

    border-radius: 18px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;

    border-left-color: rgb(14, 127, 140);
    border-right-color: rgb(14, 127, 140);
    border-top-color: rgb(14, 127, 140);
    border-bottom-color: rgb(14, 127, 140);
}

.wrist-identity {
    position: absolute;

    left: 500px;
    top: 102px;

    width: 280px;

    color: rgb(74, 82, 92);

    font-size: 11px;

    -unity-text-align: middle-center;
}
