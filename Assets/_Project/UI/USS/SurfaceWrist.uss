/*
 * Survive UI Demo - NEREID-04 wrist terminal (Phase 06 Revision round 2).
 * Floating field terminal: no enclosing rectangle. A central circular LOCAL
 * MAP is the visual anchor; thin segmented status rings hug its perimeter;
 * equipment / cargo / navigation / harvest states are detached small
 * hairline blocks. Large negative space keeps the 3D world clearly visible,
 * so the UI reads as an interface projected forward from the wrist.
 * Off-white / ink / teal, Swiss grid, restrained radius. No neon.
 */

/* ---------- Layer + open presentation ---------- */

.wrist-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

/* Transparent cluster that positions everything without a card background. */
.wrist-cluster {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -670px;
    margin-top: -470px;
    width: 1340px;
    height: 940px;
    flex-shrink: 0;
}

/* ---------- Brand line (floating, small) ---------- */

.wrist-brand {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0;
    color: #161B20;
}

.wrist-node-count {
    position: absolute;
    right: 14px;
    top: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #0E7F8C;
    letter-spacing: 0;
    background-color: rgba(233, 235, 237, 0.75);
    padding: 4px 10px;
    border-width: 1px;
    border-color: #C9CFD4;
}

/* ---------- Circular local map (dominant visual anchor) ---------- */

.wrist-map-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -310px;
    margin-top: -310px;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(226, 230, 233, 0.9);
    border-width: 1px;
    border-color: #9AA3AC;
}

.map-marker {
    position: absolute;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.map-landing {
    color: #5A6570;
    font-size: 14px;
    -unity-font-style: bold;
}

.map-player {
    position: absolute;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    color: #161B20;
    font-size: 13px;
    -unity-font-style: bold;
}

.map-nav-ring {
    position: absolute;
    width: 38px;
    height: 38px;
    border-width: 2px;
    border-color: #0E7F8C;
    border-radius: 3px;
    display: none;
}

.map-marker-btn {
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #161B20;
    border-width: 1px;
    border-color: #161B20;
    -unity-text-align: middle-center;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.map-marker-btn .map-marker-label {
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.map-marker-btn.marker-harvesting {
    background-color: #0E7F8C;
    border-color: #0A616C;
}

.map-marker-btn.marker-transmitting {
    background-color: #0A616C;
    border-color: #0E7F8C;
}

.map-marker-btn.marker-depleted {
    background-color: transparent;
    border-color: #9AA3AC;
}

.map-marker-btn.marker-depleted .map-marker-label {
    color: #7B858F;
}

.map-marker-btn.marker-selected {
    border-width: 3px;
    border-color: #161B20;
}

.map-marker-btn:hover {
    border-color: #0E7F8C;
}

.wrist-map-hint {
    display: none;
}

/* ---------- Thin ring readouts (tick segments built at runtime) ---------- */

.wrist-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    pointer-events: none;
}

.ring-satiety {
    width: 800px;
    height: 800px;
    margin-left: -400px;
    margin-top: -400px;
}

.ring-health {
    width: 900px;
    height: 900px;
    margin-left: -450px;
    margin-top: -450px;
}

.ring-tick {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #D6DBDF;
}

.ring-tick.tick-active {
    background-color: #0E7F8C;
}

.ring-tick.tick-health-active {
    background-color: #161B20;
}

/* Ring chips: caption + value in the small gaps between map and rings */

.ring-chip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: rgba(233, 235, 237, 0.72);
    border-width: 1px;
    border-color: #C9CFD4;
    padding: 3px 10px;
}

.chip-health {
    left: 50%;
    margin-left: -70px;
    top: 118px;
    width: 140px;
    height: 26px;
}

.chip-satiety {
    left: 50%;
    margin-left: -70px;
    top: 794px;
    width: 140px;
    height: 26px;
}

.ring-chip-caption {
    font-size: 10px;
    color: #4A525C;
    letter-spacing: 0;
    margin-right: auto;
}

.ring-chip-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: #161B20;
}

/* ---------- Floating side modules (detached hairline blocks) ---------- */

.float-card {
    position: absolute;
    width: 220px;
    background-color: rgba(233, 235, 237, 0.72);
    border-width: 1px;
    border-color: #C9CFD4;
    padding: 8px 12px;
}

.float-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #161B20;
    border-bottom-width: 1px;
    border-bottom-color: #C9CFD4;
    padding-bottom: 3px;
    margin-bottom: 4px;
}

.card-equip {
    left: 22px;
    top: 158px;
}

.card-cargo {
    right: 22px;
    top: 158px;
}

.card-nav {
    left: 22px;
    bottom: 170px;
}

.card-active {
    right: 22px;
    bottom: 170px;
}

.wrist-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.wrist-row-name {
    font-size: 12px;
    color: #161B20;
    margin-right: auto;
    letter-spacing: 0;
}

.wrist-row-state {
    font-size: 11px;
    -unity-font-style: bold;
    color: #0E7F8C;
    letter-spacing: 0;
}

.wrist-row-state.state-off {
    color: #7B858F;
}

.wrist-nav-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 2px;
    letter-spacing: 0;
}

.wrist-nav-distance {
    font-size: 18px;
    -unity-font-style: bold;
    color: #0E7F8C;
    margin-top: 1px;
}

.wrist-active-node {
    font-size: 13px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 2px;
    letter-spacing: 0;
}

.wrist-active-line {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.wrist-active-state {
    font-size: 12px;
    -unity-font-style: bold;
    color: #0A616C;
    margin-right: auto;
    letter-spacing: 0;
}

.wrist-active-percent {
    font-size: 15px;
    -unity-font-style: bold;
    color: #0A616C;
}

/* ---------- Footer (single small line under the cluster) ---------- */

.wrist-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -26px;
    -unity-text-align: middle-center;
    font-size: 10px;
    letter-spacing: 0;
    color: rgba(22, 27, 32, 0.8);
}

/* ---------- Custom dot cursor ---------- */

.wrist-cursor {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border-width: 1px;
    border-color: #161B20;
    background-color: rgba(14, 127, 140, 0.35);
    display: none;
    pointer-events: none;
}

.wrist-cursor.cursor-active {
    background-color: rgba(14, 127, 140, 0.6);
    border-color: #0E7F8C;
}
