/*
 * Survive UI Demo - NEREID-04 wrist terminal (Phase 06 Revision round 3).
 * Rendered into a 1280x800 RenderTexture and projected onto a tilted world
 * plane: a true "raised wrist" anchor with the world visible around it.
 * Off-white / ink / teal / hairlines, restrained radius, no neon.
 */

.wrist-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 800px;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Brand ---------- */

.wrist-brand {
    position: absolute;
    left: 16px;
    top: 10px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0;
    color: #161B20;
    background-color: rgba(233, 235, 237, 0.7);
    padding: 3px 10px;
    border-width: 1px;
    border-color: #C9CFD4;
}

/* ---------- Circular local map (visual centre of the wrist) ---------- */
/* Round 8: disc/rings/arcs are painted by RadialWristElement; this container
   only groups the markers above that translucent paint layer. */

.wrist-map-circle {
    position: absolute;
    left: 390px;
    top: 150px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.map-marker {
    position: absolute;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.map-landing {
    color: #5A6570;
    font-size: 14px;
    -unity-font-style: bold;
}

.map-player {
    position: absolute;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    color: #161B20;
    font-size: 13px;
    -unity-font-style: bold;
}

.map-nav-ring {
    position: absolute;
    width: 42px;
    height: 42px;
    border-width: 2px;
    border-color: #0E7F8C;
    border-radius: 3px;
    display: none;
}

.map-marker-btn {
    position: absolute;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #161B20;
    border-width: 1px;
    border-color: #161B20;
    -unity-text-align: middle-center;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.map-marker-btn .map-marker-label {
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.map-marker-btn.marker-harvesting {
    background-color: #0E7F8C;
    border-color: #0A616C;
}

.map-marker-btn.marker-transmitting {
    background-color: #0A616C;
    border-color: #0E7F8C;
}

.map-marker-btn.marker-depleted {
    background-color: transparent;
    border-color: #9AA3AC;
}

.map-marker-btn.marker-depleted .map-marker-label {
    color: #7B858F;
}

.map-marker-btn.marker-selected {
    border-width: 3px;
    border-color: #161B20;
}

/* ---------- Ring containers (tick segments built at runtime) ---------- */

.wrist-ring {
    position: absolute;
    pointer-events: none;
}

.ring-satiety {
    left: 310px;
    top: 70px;
    width: 660px;
    height: 660px;
}

.ring-health {
    left: 260px;
    top: 20px;
    width: 760px;
    height: 760px;
}

.ring-tick {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #D6DBDF;
}

.ring-tick.tick-active {
    background-color: #0E7F8C;
}

/* ---------- Ring containers (legacy; arcs are painted by RadialWristElement) */

.wrist-ring {
    display: none;
}

/* ---------- Health/Satiety value readouts (floating, radial positions) ----- */

.ring-chip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    width: 170px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    padding: 0 4px;
}

.chip-health {
    left: 555px;
    top: 42px;
}

.chip-satiety {
    left: 555px;
    top: 734px;
}

.ring-chip-caption {
    font-size: 12px;
    color: #7B858F;
    letter-spacing: 0;
    margin-right: auto;
}

.ring-chip-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: #161B20;
}

/* ---------- Radial sector content (no rectangles; floats on the arcs) ------ */

.wrist-card {
    position: absolute;
    width: auto;
    max-width: 210px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.wrist-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #4A525C;
    padding-bottom: 2px;
    margin-bottom: 1px;
    border-bottom-width: 0;
}

.card-equip {
    left: 225px;
    top: 178px;
}

.card-status {
    left: 865px;
    top: 178px;
}

.card-nav {
    left: 225px;
    top: 545px;
}

.card-active {
    left: 865px;
    top: 545px;
}

.wrist-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.wrist-row-name {
    font-size: 12px;
    color: #161B20;
    margin-right: auto;
    letter-spacing: 0;
}

.wrist-row-state {
    font-size: 11px;
    -unity-font-style: bold;
    color: #0E7F8C;
    letter-spacing: 0;
}

.wrist-row-state.state-off {
    color: #7B858F;
}

.wrist-nav-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 2px;
    letter-spacing: 0;
}

.wrist-nav-distance {
    font-size: 20px;
    -unity-font-style: bold;
    color: #0E7F8C;
    margin-top: 1px;
}

.wrist-active-node {
    font-size: 14px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 2px;
    letter-spacing: 0;
}

.wrist-active-line {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.wrist-active-state {
    font-size: 13px;
    -unity-font-style: bold;
    color: #0A616C;
    margin-right: auto;
    letter-spacing: 0;
}

.wrist-active-percent {
    font-size: 16px;
    -unity-font-style: bold;
    color: #0A616C;
}

/* ---------- Footer ---------- */

.wrist-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    -unity-text-align: middle-center;
    font-size: 11px;
    letter-spacing: 0;
    color: rgba(22, 27, 32, 0.85);
}

/* ---------- Project dot cursor (drawn on the wrist display) ---------- */

.wrist-cursor {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border-width: 1px;
    border-color: #161B20;
    background-color: rgba(14, 127, 140, 0.35);
    display: none;
    pointer-events: none;
}

.wrist-cursor.cursor-active {
    background-color: rgba(14, 127, 140, 0.6);
    border-color: #0E7F8C;
}
