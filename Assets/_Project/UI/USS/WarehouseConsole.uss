/*
 * Survive UI Demo - Console02 仓库 / Warehouse (Phase 09B PASS 9).
 *
 * Light canvas, restrained ink text, ONE cyan accent and hairlines. The layout
 * is the approved reference: 仓库 title / category tabs carrying the LB-RB hint /
 * 4 x 3 item grid / selected item detail / a single [B] 返回 key line.
 * Targets the 1920 x 1080 console RenderTexture.
 */

.warehouse-root {
    background-color: #E9EBED;
    flex-grow: 1;
    flex-direction: column;
    padding-left: 76px;
    padding-right: 76px;
    padding-top: 34px;
    padding-bottom: 22px;
}

/* ---------- Title ---------- */

.wh-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.wh-title {
    font-size: 34px;
    -unity-font-style: medium;
    letter-spacing: 0px;
    color: #161B20;
}

.wh-header-rule {
    flex-grow: 1;
    height: 1px;
    background-color: #C9CFD4;
    margin-left: 30px;
    margin-right: 24px;
}

.wh-index {
    font-size: 20px;
    color: #7B858F;
}

/* ---------- Category tabs (the LB / RB paging hint lives here) ---------- */

.wh-tabs {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    height: 52px;
    margin-bottom: 16px;
}

.wh-tab {
    height: 42px;
    min-width: 132px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #E1E4E7;
    border-width: 1px;
    border-color: #D3D8DC;
    /* Idle tab sits slightly LOWER than the selected one. */
    translate: 0 4px;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.12s;
}

.wh-tab:hover {
    border-color: #9FBFC4;
}

.wh-tab-label {
    font-size: 17px;
    color: #5A6570;
}

/* Selected: raised, lighter, and framed in cyan - deliberate but restrained. */
.wh-tab-active {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #0E7F8C;
    translate: 0 -4px;
}

.wh-tab-active .wh-tab-label {
    color: #161B20;
    -unity-font-style: bold;
}

.wh-tab-spacer {
    flex-grow: 1;
}

.wh-tab-key {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #161B20;
    margin-left: 14px;
}

.wh-tab-arrow {
    font-size: 13px;
    color: #0E7F8C;
    margin-left: 10px;
}

/* ---------- Body: grid + detail ---------- */

.wh-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.wh-grid-column {
    width: 58%;
    flex-shrink: 0;
    padding-right: 30px;
    border-right-width: 1px;
    border-right-color: #DEE2E5;
}

.wh-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ---------- Item cell ---------- */

.wh-cell {
    width: 23.2%;
    height: 172px;
    margin-right: 2.4%;
    margin-bottom: 14px;
    align-items: center;
    justify-content: center;
    background-color: #F2F4F6;
    border-width: 1px;
    border-color: #DFE3E7;
    transition-property: border-color, background-color;
    transition-duration: 0.13s;
}

/* Every 4th cell closes a row (the grid is exactly 4 columns wide). */
.wh-cell-rowend {
    margin-right: 0px;
}

.wh-cell:hover {
    border-color: #9FBFC4;
    background-color: #F7F9FA;
}

/* Focus / selection: one cyan frame plus two light corner marks. */
.wh-cell-focused {
    border-color: #0E7F8C;
    background-color: #F7FBFC;
}

.wh-cell-icon {
    width: 86px;
    height: 86px;
}

/* The shared item marks (Processing / Preparation sketches) fill their host. */
.warehouse-root .process-sketch,
.warehouse-root .prep-sketch,
.warehouse-root .warehouse-icon {
    flex-grow: 1;
}

.wh-cell-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 6px;
}

.wh-cell-sub {
    font-size: 12px;
    color: #5A6570;
    margin-top: 2px;
}

.wh-cell-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    display: none;
}

.wh-cell-focused .wh-cell-corner {
    display: flex;
}

.wh-corner-tl {
    left: -1px;
    top: -1px;
    border-left-width: 2px;
    border-left-color: #0E7F8C;
    border-top-width: 2px;
    border-top-color: #0E7F8C;
}

.wh-corner-br {
    right: -1px;
    bottom: -1px;
    border-right-width: 2px;
    border-right-color: #0E7F8C;
    border-bottom-width: 2px;
    border-bottom-color: #0E7F8C;
}

/* Empty slot: faint crosshair, never focusable, never clickable. */
.wh-cell-empty {
    background-color: #EFF1F3;
    border-color: #E4E8EB;
    align-items: center;
    justify-content: center;
}

.wh-empty-mark {
    font-size: 25px;
    color: rgba(22, 27, 32, 0.10);
}

/* ---------- Detail panel ---------- */

.wh-detail-column {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 40px;
}

.wh-detail-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: #7B858F;
}

.wh-detail-icon-host {
    width: 168px;
    height: 168px;
    margin-top: 18px;
    background-color: #F2F4F6;
    border-width: 1px;
    border-color: #DFE3E7;
    align-items: center;
    justify-content: center;
}

.wh-detail-icon {
    width: 120px;
    height: 120px;
}

.wh-detail-head {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 22px;
}

.wh-detail-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: #161B20;
}

.wh-detail-count {
    font-size: 22px;
    color: #0E7F8C;
    margin-left: 18px;
}

.wh-detail-state {
    font-size: 14px;
    color: #0E7F8C;
    margin-top: 6px;
}

.wh-detail-text {
    font-size: 15px;
    color: #4A525C;
    white-space: normal;
    margin-top: 14px;
    width: 100%;
}

.wh-detail-rule {
    height: 1px;
    background-color: #DEE2E5;
    width: 100%;
    margin-top: 22px;
}

.wh-caption {
    font-size: 12px;
    color: #9AA2AA;
    margin-top: 12px;
}

/* ---------- Bottom key line ---------- */

.wh-prompt-host {
    flex-shrink: 0;
    width: 100%;
    height: 52px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

/* =====================================================================
 * Project cursor, document-wide (Phase 09B PASS 6 follow-up).
 *
 * UI Toolkit re-applies the hovered element's own cursor on every hover
 * change. Every document (hub app, ship HUD, surface HUD / wrist, main menu,
 * warehouse console, modal sheets) therefore carries the project's dot, so no
 * element can ever resolve to the stock Windows arrow. Actionable elements
 * override it with the dot+ring asset where a page defines them.
 * ===================================================================== */

* {
    cursor: url("../Cursors/T_CursorDot.png") 16 16;
}
