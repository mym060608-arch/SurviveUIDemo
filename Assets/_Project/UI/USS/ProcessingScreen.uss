/*
 * Survive UI Demo - Processing / 资源加工 (Phase 04; rebuilt in Phase 09B PASS 5).
 *
 * The page keeps the light industrial / aerospace language of the other Hub
 * screens: cold grey canvas, hairline rules, one low-saturation cyan accent for
 * interaction and a restrained orange for the refinery heat. No gradients, no
 * glow, no neon: the refinery core is the single visual anchor and everything
 * else stays quiet around it.
 *
 * Layout contract (the reference the round was approved against):
 *   left    加工列表 / 当前配方 / 加工数量 < n >
 *   centre  矿物 -> 精炼炉 -> 燃料 + 合金 (progress + run bar)
 *   right   当前库存 / 加工效率
 *   bottom  [B] 返回 · [A] 确认加工
 */

/* ---------- Screen shell / top system bar ---------- */

.processing-screen {
    flex-direction: column;
}

.process-topbar {
    flex-shrink: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    padding-left: 64px;
    padding-right: 64px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

/* ---------- Screen identity strip ---------- */

.process-head {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 64px;
    padding-right: 64px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.process-head-main {
    flex-direction: row;
    align-items: flex-end;
}

.process-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #161B20;
    margin-right: 24px;
}

.process-subtitle {
    font-size: 11px;
    letter-spacing: 2px;
    color: #7B858F;
}

.process-head-data {
    flex-direction: column;
    min-width: 200px;
    padding-left: 26px;
    border-left-width: 1px;
    border-left-color: #DEE2E5;
}

/* ---------- Main three-column body ---------- */

.processing-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 64px;
    padding-right: 64px;
}

.process-col-left {
    width: 348px;
    flex-shrink: 0;
    flex-direction: column;
    padding-right: 30px;
    border-right-width: 1px;
    border-right-color: #DEE2E5;
}

.process-col-center {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    padding-left: 30px;
    padding-right: 30px;
}

.process-col-right {
    width: 332px;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 30px;
    border-left-width: 1px;
    border-left-color: #DEE2E5;
}

.panel-header-tag {
    font-size: 9px;
    letter-spacing: 1px;
    color: #A6ADB4;
    margin-left: 12px;
}

/* ---------- Left: 加工列表 ---------- */

.recipe-list {
    flex-direction: column;
    margin-top: 6px;
}

.recipe-row {
    flex-direction: row;
    align-items: center;
    height: 74px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #D8DCE0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.recipe-row:hover {
    background-color: #F4F7F8;
    border-color: #C3CBD1;
}

.recipe-row.recipe-selected {
    background-color: #F7FAFA;
    border-color: #C6D3D6;
    border-left-color: #0E7F8C;
}

.recipe-row.ui-focus {
    background-color: #EEF6F7;
    border-color: #0E7F8C;
    border-left-color: #0E7F8C;
}

.recipe-row:disabled {
    background-color: #F3F5F6;
    border-color: #E1E5E8;
}

/* Code-drawn marks fill whatever box their host defines (same contract as the
   Preparation sketches: an inline flex-grow on the drawing would outrank every
   layout rule and stretch the mark inside its token). */
.process-sketch {
    flex-grow: 1;
}

.refinery-core-graphic {
    flex-grow: 1;
}

.recipe-icon {
    width: 40px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 14px;
}

.recipe-text {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
}

.recipe-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: #161B20;
}

.recipe-sub {
    font-size: 10px;
    color: #7B858F;
    margin-top: 4px;
}

.recipe-chevron {
    font-size: 16px;
    color: #0E7F8C;
    margin-left: 8px;
}

.recipe-note {
    font-size: 10px;
    color: #9AA1A8;
    margin-top: 8px;
}

/* ---------- Left: 当前配方 ---------- */

.recipe-current {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #E4E7EA;
}

.recipe-current-icon {
    width: 42px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 14px;
}

.recipe-current-text {
    flex-direction: column;
    min-width: 0;
}

.recipe-current-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: #161B20;
}

.recipe-current-flow {
    font-size: 11px;
    color: #4A525C;
    margin-top: 4px;
}

/* ---------- Left: 加工数量 < n > ---------- */

.quantity-row {
    flex-direction: row;
    align-items: stretch;
    height: 78px;
    margin-top: 8px;
}

.quantity-arrow {
    width: 52px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: #161B20;
    background-color: #F1F3F5;
    border-width: 1px;
    border-color: #C9CFD4;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.quantity-arrow:hover {
    background-color: #E7EDEF;
    border-color: #0E7F8C;
    color: #0A616C;
}

.quantity-arrow:disabled {
    background-color: #F5F6F7;
    border-color: #E1E5E8;
    color: #B7BDC3;
}

.quantity-box {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #C9CFD4;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.quantity-row .quantity-box {
    border-left-width: 1px;
    border-right-width: 1px;
}

.quantity-value {
    font-size: 34px;
    -unity-font-style: bold;
    color: #161B20;
    min-width: 62px;
    -unity-text-align: middle-center;
}

.quantity-unit {
    font-size: 11px;
    color: #7B858F;
    margin-left: 8px;
}

/* Focus / lock states of the quantity control. */
.quantity-row.ui-focus .quantity-box {
    background-color: #F2F9FA;
    border-color: #0E7F8C;
}

.quantity-row.ui-focus .quantity-value {
    color: #0A616C;
}

.quantity-row.ui-focus .quantity-arrow:enabled {
    border-color: #0E7F8C;
    color: #0A616C;
}

.quantity-row.quantity-disabled .quantity-box {
    background-color: #F5F6F7;
    border-color: #E1E5E8;
}

.quantity-row.quantity-disabled .quantity-value {
    color: #8C939A;
}

.quantity-hint {
    font-size: 10px;
    color: #7B858F;
    margin-top: 8px;
}

/* ---------- Centre: work area ---------- */

.core-sys-dot {
    width: 6px;
    height: 6px;
    background-color: #0E7F8C;
    margin-left: 18px;
    margin-right: 8px;
}

.core-sys-label {
    font-size: 10px;
    color: #7B858F;
}

.core-strip {
    flex-shrink: 0;
    height: 8px;
    margin-top: 10px;
}

.process-dot-strip {
    flex-grow: 1;
    height: 8px;
}

.core-panel {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    border-width: 1px;
    border-color: #D8DCE0;
    background-color: #F6F7F8;
    padding-top: 18px;
    padding-bottom: 16px;
    padding-left: 24px;
    padding-right: 24px;
    margin-top: 6px;
}

/* Main state + live progress readout (visual anchor of the panel) */
.core-status-row {
    flex-direction: row;
    align-items: flex-end;
}

.core-status {
    font-size: 30px;
    -unity-font-style: bold;
    color: #161B20;
    margin-right: auto;
}

.core-progress-readout {
    flex-direction: row;
    align-items: flex-end;
}

.core-progress-caption {
    font-size: 10px;
    color: #7B858F;
    margin-right: 10px;
}

.core-progress-big {
    font-size: 30px;
    -unity-font-style: bold;
    color: #0A616C;
    min-width: 90px;
    -unity-text-align: middle-right;
}

/* Refinery flow track: 矿物 -> 精炼炉 -> 燃料 / 合金 */
.core-flow {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    margin-bottom: 12px;
}

.flow-node {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #D8DCE0;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
}

.flow-icon {
    width: 54px;
    height: 38px;
    margin-bottom: 8px;
}

.flow-node-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: #161B20;
}

.flow-node-sub {
    font-size: 9px;
    color: #7B858F;
    margin-top: 6px;
}

/* The refinery itself: the page's first visual anchor. */
.flow-core {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}

.refinery-core {
    width: 238px;
    height: 238px;
}

.flow-core-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #161B20;
    margin-top: 6px;
}

.core-batch-note {
    color: #0A616C;
    -unity-font-style: bold;
}

.flow-conn {
    flex-grow: 1;
    min-width: 48px;
    align-self: center;
    height: 18px;
    margin-left: 10px;
    margin-right: 10px;
}

.process-flow-line {
    flex-grow: 1;
    height: 18px;
}

/* Output branch: two product rows behind one rail. */
.flow-output {
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}

.flow-node-output {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 22px;
}

.flow-node-output .flow-icon {
    width: 46px;
    height: 32px;
    margin-bottom: 0px;
    margin-right: 12px;
}

.flow-output-text {
    flex-direction: column;
}

.flow-split-rule {
    height: 1px;
    background-color: #D8DCE0;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 22px;
}

/* Active / settled state emphasis (driven by stage classes) */
.process-col-center.stage-running .flow-core-text {
    color: #0A616C;
}

.process-col-center.stage-running .core-progress-caption {
    color: #0A616C;
}

.process-col-center.stage-running .progress-fill {
    background-color: #C8721B;
}

.process-col-center.stage-complete .result-panel {
    background-color: #EDF5F6;
    border-color: #B9CDD1;
}

.process-col-center.stage-complete .result-caption {
    color: #0A616C;
}

/* ---------- Centre: expected / settled output row ---------- */

.result-panel {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: #DEE2E5;
    background-color: #FFFFFF;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
}

.result-mark {
    width: 3px;
    height: 22px;
    background-color: #0E7F8C;
    margin-right: 14px;
}

.result-caption {
    font-size: 12px;
    color: #161B20;
    -unity-font-style: bold;
    margin-right: auto;
}

.output-key {
    font-size: 13px;
    color: #4A525C;
    margin-left: 18px;
}

.result-value {
    font-size: 26px;
    -unity-font-style: bold;
    color: #0A616C;
    margin-left: 10px;
}

.result-sep {
    font-size: 14px;
    color: #C9CFD4;
    margin-left: 14px;
}

/* ---------- Centre: run progress rule ---------- */

.core-track-row {
    flex-shrink: 0;
    margin-top: 12px;
}

.progress-track {
    height: 6px;
    background-color: #D3D8DC;
}

.progress-fill {
    height: 6px;
    width: 0%;
    background-color: #0E7F8C;
}

/* ---------- Right: 当前库存 + 加工效率 ---------- */

.inventory-line {
    flex-direction: row;
    align-items: center;
    height: 58px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.inventory-icon {
    width: 40px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 12px;
}

.inventory-line-raw {
    height: 66px;
}

.inventory-line-raw .inventory-value {
    font-size: 32px;
}

.inventory-key {
    font-size: 13px;
    color: #4A525C;
    margin-right: auto;
}

.inventory-value {
    font-size: 28px;
    -unity-font-style: bold;
    color: #161B20;
}

.meta-line {
    flex-direction: row;
    align-items: center;
    height: 42px;
    border-bottom-width: 1px;
    border-bottom-color: #DEE2E5;
}

.meta-key {
    font-size: 12px;
    color: #4A525C;
    margin-right: auto;
}

.meta-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: #161B20;
}

/* ---------- Bottom action strip ---------- */

.process-actionbar {
    flex-shrink: 0;
    height: 76px;
    flex-direction: row;
    align-items: center;
    padding-left: 64px;
    padding-right: 64px;
    border-top-width: 1px;
    border-top-color: #C9CFD4;
    background-color: #E4E7EA;
}

.actionbar-context {
    flex-direction: column;
    margin-right: auto;
}

.actionbar-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: #7B858F;
}

.actionbar-note {
    font-size: 10px;
    color: #9AA1A8;
    margin-top: 4px;
}

/* The shared Phase 09B prompt bar is mounted here (inside the action strip,
   left of the confirm action) so the keys sit next to the operation they
   describe instead of floating over the page. */
.process-prompt-host {
    width: 560px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 26px;
}

.process-action {
    width: 320px;
    height: 50px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #161B20;
    border-width: 1px;
    border-color: #161B20;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.process-action:hover {
    background-color: #0E7F8C;
    border-color: #0E7F8C;
}

.process-action:active {
    background-color: #0A616C;
    border-color: #0A616C;
}

.process-action:disabled {
    background-color: #B7BDC3;
    border-color: #A9AFB5;
    color: #EDEFF1;
}
