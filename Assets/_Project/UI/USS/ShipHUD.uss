/*
 * Survive UI Demo - ARK-07 ship interior HUD (Phase 07 Checkpoint A).
 * Chinese-first. Inherits the off-white/ink/teal/hairline visual language
 * but stays light so the graybox ship world remains the primary visual.
 */

.ship-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Compartment tag (top-left) ---------- */

.ship-zone-chip {
    position: absolute;
    left: 24px;
    top: 24px;
    min-width: 180px;
    background-color: rgba(237, 239, 241, 0.9);
    border-width: 1px;
    border-color: #C9CFD4;
    padding: 10px 16px;
}

.ship-zone-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: #161B20;
}

.ship-zone-meta {
    font-size: 10px;
    letter-spacing: 1px;
    color: #5A6570;
    margin-top: 2px;
    -unity-font-style: bold;
}

/* ---------- Ship identity (top-right) ---------- */

.ship-title {
    position: absolute;
    right: 24px;
    top: 26px;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(237, 239, 241, 0.92);
    background-color: rgba(22, 27, 32, 0.55);
    padding: 6px 12px;
}

/* ---------- Centre crosshair ---------- */

.ship-crosshair-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.ship-xh-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(237, 239, 241, 0.85);
}

.ship-xh-dot.ship-dot-valid {
    background-color: #0E7F8C;
}

.ship-xh-dot.ship-dot-blocked {
    background-color: #5A6570;
}

.ship-xh-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -10px;
    margin-top: -10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border-width: 1px;
    border-color: transparent;
    display: none;
}

.ship-xh-ring.ship-ring-visible {
    display: block;
}

.ship-xh-ring.ship-ring-valid {
    border-color: #0E7F8C;
}

.ship-xh-ring.ship-ring-blocked {
    border-color: #5A6570;
}

/* ---------- Interaction prompt (bottom centre) ---------- */

.ship-prompt {
    position: absolute;
    left: 50%;
    bottom: 30px;
    margin-left: -180px;
    width: 360px;
    height: 42px;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 0;
    background-color: rgba(22, 27, 32, 0.78);
    border-width: 1px;
    border-color: rgba(14, 127, 140, 0.6);
    padding-top: 9px;
    display: none;
}
